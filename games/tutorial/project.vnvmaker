    {
      "id": "y7ntbw",
      "label": "demo_pushmove_transitions",
      "bg": null,
      "music": null,
      "events": [
        {
          "id": "5m0mmw",
          "type": "narration",
          "text": "e: The PushMove transitions use the new scene to push the old one out. Let's take a look."
        },
        {
          "id": "clt6hd",
          "type": "image",
          "image": "bg whitehouse",
          "side": "center"
        },
        {
          "id": "a5wzag",
          "type": "raw",
          "raw_code": "hide eileen",
          "_isSkipped": true
        },
        {
          "id": "huiew1",
          "type": "effect",
          "kind": "pushright",
          "dur": 0.5
        },
        {
          "id": "l5xaga",
          "type": "narration",
          "text": "There's pushright..."
        },
        {
          "id": "ojbrg9",
          "type": "image",
          "image": "bg washington",
          "side": "center"
        },
        {
          "id": "e3t18n",
          "type": "effect",
          "kind": "pushleft",
          "dur": 0.5
        },
        {
          "id": "qnl82c",
          "type": "narration",
          "text": "...pushleft..."
        },
        {
          "id": "ltvoe3",
          "type": "image",
          "image": "bg whitehouse",
          "side": "center"
        },
        {
          "id": "6h081y",
          "type": "effect",
