      "bg": "bg washington",
      "music": "sunflower-slow-drag.ogg",
      "events": [
        {
          "id": "ubmfd1",
          "type": "bg",
          "bg": "bg washington"
        },
        {
          "id": "gejsje",
          "type": "image",
          "image": "eileen vhappy",
          "side": "center"
        },
        {
          "id": "wqalhz",
          "type": "effect",
          "kind": "dissolve",
          "dur": 0.5
        },
        {
          "id": "1hvoun",
          "type": "music",
          "music": "sunflower-slow-drag.ogg"
        },
        {
          "id": "t6sdfi",
          "type": "narration",
          "text": "e: Hi! My name is Eileen, and I'd like to welcome you to the Ren'Py tutorial."
        },
        {
          "id": "hyd854",
          "type": "image",
          "image": "eileen happy",
          "side": "center"
        },
        {
          "id": "2x7ppr",
          "type": "narration",
          "text": "e: In this tutorial, we'll teach you the basics of Ren'Py, so you can make games of your own. We'll also demonstrate many features, so you can see what Ren'Py is capable of."
        },
        {
          "id": "jljai7",
          "type": "jump",
          "scene_id": "rntssc",
          "transition": "none",
          "_targetLabel": "tutorials"
        }
      ],
      "scene_ids": []
    },
