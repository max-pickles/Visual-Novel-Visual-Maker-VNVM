          "side": "center"
        },
        {
          "id": "n0530t",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "a 3000 degree knife,",
          "side": "center"
        },
        {
          "id": "mfsagu",
          "type": "image",
