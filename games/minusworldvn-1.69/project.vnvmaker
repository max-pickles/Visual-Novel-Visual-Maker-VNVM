        },
        {
          "id": "07coab",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Right, the old man was workin' with Moneybags. He might know where that gat'dang Heartless is being summoned.",
          "side": "center"
