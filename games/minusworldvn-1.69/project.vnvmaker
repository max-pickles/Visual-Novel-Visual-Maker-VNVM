    {
      "id": "yjv8kf",
      "label": "takagi_end",
      "bg": "bg ring",
      "music": "mmsf.ogg",
      "events": [
        {
          "id": "pm2d9o",
          "type": "narration",
          "text": "brrrrrring brrrrrrrrrrrrrring"
        },
        {
          "id": "h39a2l",
          "type": "narration",
          "text": "Your phone is ringing."
        },
        {
          "id": "k6cwox",
          "type": "image",
          "image": "cellphone",
          "side": "left"
        },
        {
          "id": "x1zh3e",
          "type": "music",
          "music": "mmsf.ogg"
        },
        {
          "id": "3d341k",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "It's me, Hank. There's a real gosh darn situation over at the wrestling ring. How soon can you be here?",
          "side": "center"
        },
        {
          "id": "0o9vg9",
          "type": "narration",
          "text": "You walk Takagi home, and take the next bus downtown to meet with Hank."
        },
        {
          "id": "epssx5",
          "type": "bg",
          "bg": "bg ringside"
        },
        {
          "id": "7onzfj",
          "type": "narration",
          "text": "Announcer\" \"What an amaaaaazing match ladies and gentlemen! Our superstars fought valiantly, but in the end there can only be one winner!"
        },
        {
          "id": "roxv8y",
          "type": "narration",
          "text": "It looks like you arrived just as the match was ending."
        },
        {
          "id": "wqgglk",
          "type": "image",
          "image": "hank friendly",
          "side": "center"
        },
        {
          "id": "lvbnjo",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Mario, I finally found you. Listen, this is no good wholesome wrestling ring.",
          "side": "center"
        },
        {
          "id": "5c3sde",
          "type": "image",
          "image": "hank determined",
          "side": "center"
        },
        {
          "id": "at9vgt",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "They've been bought out by some dang suit, and monsters called Heartless have been taking down wrestlers left and right. It's not right, I tell you hwat.",
          "side": "center"
        },
        {
          "id": "der83p",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Things are about to get frisky, so I need you to pull a fire alarm and make the audience skedaddle while I handle things in the ring.",
          "side": "center"
        },
        {
          "id": "maltf1",
          "type": "narration",
          "text": "Announcer\" \"Aaaaaaaaallright folks, I think you know what time it is! Put your hands together for the maaaaaaaaain eeeeeeeevent!"
        },
        {
          "id": "4s99tt",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "We're outta time, buddy. You need to make tracks, and fast.",
          "side": "center"
        },
        {
          "id": "wrrjyp",
          "type": "narration",
          "text": "Hank points his Keyblade at you, and a warm light surrounds you."
        },
        {
          "id": "inukpj",
          "type": "narration",
          "text": "You now have protection from darkness!"
        },
        {
          "id": "jxz138",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Gat'dang Heartless!",
          "side": "center"
        },
        {
          "id": "9qpokq",
          "type": "bg",
          "bg": "bg ring"
        },
        {
          "id": "4yzgu4",
          "type": "image",
          "image": "hank determined",
          "side": "left"
        },
        {
          "id": "95vvoa",
          "type": "image",
          "image": "heartless basic",
          "side": "right"
        },
        {
          "id": "ubtppf",
          "type": "narration",
          "text": "Hank jumps into the ring as the spotlights come on. A strange monster is in the middle of the ring, darkness swirling at its feet. The crowd erupts into deafening applause."
        },
        {
          "id": "lq06ad",
          "type": "narration",
          "text": "Announcer\" \"That's right folks, it's the star of the show: the Heartless!"
        },
        {
          "id": "yc1ff1",
          "type": "narration",
          "text": "Announcer\" \"And tonight, live on stage, he's going to take your hearts!"
        },
        {
          "id": "yx4q9d",
          "type": "narration",
          "text": "The darkness swirling around the Heartless expands, surrounding the audience. Their applause slowly goes quiet, and around you, people begin to collapse one by one."
        },
        {
          "id": "vxkj6o",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "I'm gonna pound you like a cheap skirt steak!",
          "side": "center"
        },
        {
          "id": "f8ac5b",
          "type": "narration",
          "text": "Hank jumps forward, taking a wild leaping swing at the Heartless. At the last second, it moves just a few inches to the side, completely out of harm's way."
        },
        {
          "id": "dv0uet",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Slow down y'dang mongrel!",
          "side": "center"
        },
        {
          "id": "qqq5hk",
          "type": "narration",
          "text": "It looks like Hank is having trouble."
        },
        {
          "id": "1vznc9",
          "type": "jump",
          "scene_id": "e78va8",
          "transition": "none",
          "_targetLabel": "battle_choice"
        }
      ],
      "ending_type": "true"
    },
    {
      "id": "e78va8",
      "label": "battle_choice",
      "bg": null,
      "music": null,
      "events": [
        {
          "id": "anpxzp",
          "type": "choice",
          "prompt": "",
          "opts": [
            {
              "id": "7ledp4",
              "text": "Help Hank.",
              "scene": "mtueey",
              "is_incorrect": true
            },
            {
              "id": "qt4c3x",
              "text": "Let him do it alone.",
              "scene": "bv1sri",
              "is_correct": true
            }
          ]
        }
      ]
    },
    {
      "id": "bv1sri",
      "label": "battle_loop",
      "bg": null,
      "music": null,
      "events": [
        {
          "id": "30o8r1",
          "type": "narration",
          "text": "He needs your help!"
        },
        {
          "id": "8o9p5n",
          "type": "jump",
          "scene_id": "e78va8",
          "transition": "dissolve",
          "_targetLabel": "battle_choice"
        }
      ]
    },
    {
      "id": "mtueey",
      "label": "battle_win",
      "bg": "bg alley",
      "music": "etrian.ogg",
      "events": [
        {
          "id": "qknu1s",
          "type": "narration",
          "text": "You pull your assault rifle from your backpack and fire at the Heartless. It evades your attack, but moves right into Hank's range. With one mighty swing, he smashes the Heartless into dust."
        },
        {
          "id": "gbxgf0",
          "type": "bg",
          "bg": "bg ring"
        },
        {
          "id": "4fx9an",
          "type": "image",
          "image": "hank friendly",
          "side": "center"
        },
        {
          "id": "4kq9hy",
          "type": "music",
          "music": "recet2.ogg"
        },
        {
          "id": "ra57iy",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Phew, that was a close one. Looks like we finished it before anyone got hurt.",
          "side": "center"
        },
        {
          "id": "k487t7",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Listen Mario, that wasn't the first Heartless, and it sure as heck won't be the last.",
          "side": "center"
        },
        {
          "id": "o7a61z",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "I didn't want to involve you in this, but it looks like I have no choice. If I fall in battle, you gotta take my Keyblade and protect the world from them dang Heartless.",
          "side": "center"
        },
        {
          "id": "dfzpue",
          "type": "narration",
          "text": "You're shocked by Hank's words. All you can manage is a quick nod."
        },
        {
          "id": "mh7qf1",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Thank you, Mario. You should get home, while I check on the civilians.",
          "side": "center"
        },
        {
          "id": "2nhpez",
          "type": "bg",
          "bg": "bg alley"
        },
        {
          "id": "92cynp",
          "type": "music",
          "music": "etrian.ogg"
        },
        {
          "id": "dbahcs",
          "type": "narration",
          "text": "You leave the wrestling ring. It's gotten late, and many of the busses have stopped running. You'll have to walk most of the way home."
        },
        {
          "id": "z0p7s8",
          "type": "narration",
          "text": "There's no one on the street, which you think is strange. You'd expect to see a lot of people, even at night, in this part of town."
        },
        {
          "id": "3nu57l",
          "type": "narration",
          "text": "Feeling scared, you keep looking down at the ground while walking home."
        },
        {
          "id": "ui95w6",
          "type": "bg",
          "bg": "bg shadow"
        },
        {
          "id": "zpt899",
          "type": "narration",
          "text": "Suddenly, a shadow stretching towards you catches your eye-- but there isn't anyone around you."
        },
        {
          "id": "bn916w",
          "type": "narration",
          "text": "You look up to see who's there,"
        },
        {
          "id": "v4zxjt",
          "type": "bg",
          "bg": "bg alley"
        },
        {
          "id": "3fhbzh",
          "type": "image",
          "image": "moneybags small at position1",
          "side": "center"
        },
        {
          "id": "h79718",
          "type": "narration",
          "text": "and see a man walking in front of you. But he looks a little strange."
        },
        {
          "id": "no7s1d",
          "type": "narration",
          "text": "Since he's walking very slow, you soon catch up with him."
        },
        {
          "id": "k3hiv5",
          "type": "image",
          "image": "moneybags medium at position2",
          "side": "center"
        },
        {
          "id": "kul73i",
          "type": "narration",
          "text": "He seems to be wearing a business suit, and featureless black shoes."
        },
        {
          "id": "heniap",
          "type": "narration",
          "text": "Worse, he's not wearing any pants, and looks like he only has one giant finger and a thumb on each hand."
        },
        {
          "id": "uipd0j",
          "type": "narration",
          "text": "It seems so weird that you stop walking."
        },
        {
          "id": "nw9kjw",
          "type": "narration",
          "text": "You don't feel like you should get any closer to him, and you don't have the guts to pass him by."
        },
        {
          "id": "187ngt",
          "type": "raw",
          "raw_code": "hide moneybags",
          "_isSkipped": true
        },
        {
          "id": "fxqdun",
          "type": "image",
          "image": "moneybags spooky",
          "side": "center"
        },
        {
          "id": "dxtoj9",
          "type": "bg",
          "bg": "bg alley"
        },
        {
          "id": "wl5gtz",
          "type": "image",
          "image": "moneybags neutral",
          "side": "center"
        },
        {
          "id": "9x8fiv",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "Mario, I didn't know you were in town! I'm glad I ran into you. We have very important matters to discuss.",
          "side": "center"
        },
        {
          "id": "ey6fh0",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "As you know, I'm an incredibly wealthy, successful business owner. I've come to Smalltown seeking new opportunities.",
          "side": "center"
        },
        {
          "id": "ad3flb",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "And you, old friend, are just the man I need to seize those opportunities. This is a very exciting, once in a lifetime offer.",
          "side": "center"
        },
        {
          "id": "5tn4al",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "All you need to do is provide me some initial capital. Say, one million gems should do it.",
          "side": "center"
        },
        {
          "id": "c8ih7f",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "I'll handle the rest, and in a few months, your investment will pay out tenfold! So, my dearest compatriot, what do you say?",
          "side": "center"
        },
        {
          "id": "1icnmj",
          "type": "choice",
          "prompt": "",
          "opts": [
            {
              "id": "gaom0s",
              "text": "I'm not sure...",
              "scene": "n6dfrw"
            },
            {
              "id": "8lxmnk",
              "text": "Seems like a lot of money.",
              "scene": "n6dfrw"
            },
            {
              "id": "v8deaz",
              "text": "I don't think that's a real currency.",
              "scene": "n6dfrw"
            },
            {
              "id": "aji11m",
              "text": "What happened to selling boss keys?",
              "scene": "n6dfrw"
            }
          ]
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "n6dfrw",
      "label": "moneybags_bad",
      "bg": null,
      "music": null,
      "events": [
        {
          "id": "4q1e21",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "Well, well, well...",
          "side": "center"
        },
        {
          "id": "2fblpi",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "You could've been rich beyond your wildest dreams! But if you can't provide the funding, I'll find it somewhere else.",
          "side": "center"
        },
        {
          "id": "aqemam",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "This was your last chance, Mario. You should've invested while you still could.",
          "side": "center"
        },
        {
          "id": "zzr7ys",
          "type": "raw",
          "raw_code": "hide moneybags",
          "_isSkipped": true
        },
        {
          "id": "3usz0h",
          "type": "narration",
          "text": "Moneybags leaves, disappearing into the night. You decide to jog the rest of the way home."
        },
        {
          "id": "35k6rc",
          "type": "jump",
          "scene_id": "nqhyoj",
          "transition": "none",
          "_targetLabel": "day_two"
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "nqhyoj",
      "label": "day_two",
      "bg": "bg leskoland",
      "music": "metro2.ogg",
      "events": [
        {
          "id": "r7u3gj",
          "type": "bg",
          "bg": "bg room"
        },
        {
          "id": "2npspw",
          "type": "music",
          "music": "recet1.ogg"
        },
        {
          "id": "ng67gl",
          "type": "narration",
          "text": "You enjoy a deep sleep after your eventful first day of school."
        },
        {
          "id": "lv8nwv",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Hey, are ya decent? I need to talk to ya.",
          "side": "center"
        },
        {
          "id": "507hme",
          "type": "narration",
          "text": "You crawl out of bed, and unlock your door to speak with Hank."
        },
        {
          "id": "0id8qu",
          "type": "image",
          "image": "hank determined",
          "side": "center"
        },
        {
          "id": "6u22dx",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Look, I didn't want you to know about all this hullaballooh, but it's a little late for that now.",
          "side": "center"
        },
        {
          "id": "u3j0dp",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "I just wanted to let you know that I'll be out fighting those dang Heartless again today. If I don't come home, well... you get the idea.",
          "side": "center"
        },
        {
          "id": "1onbt3",
          "type": "narration",
          "text": "You nod in solemn understanding."
        },
        {
          "id": "dzc6he",
          "type": "image",
          "image": "hank friendly",
          "side": "center"
        },
        {
          "id": "wgdg4t",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "But enough doom and gloom. I believe it's your second day of school, so get out there, buddy!",
          "side": "center"
        },
        {
          "id": "rlc3mz",
          "type": "bg",
          "bg": "bg house"
        },
        {
          "id": "b13tkm",
          "type": "wait",
          "dur": 2
        },
        {
          "id": "ajoqg5",
          "type": "bg",
          "bg": "bg school"
        },
        {
          "id": "ulhpgl",
          "type": "wait",
          "dur": 2
        },
        {
          "id": "gdkymb",
          "type": "bg",
          "bg": "bg class"
        },
        {
          "id": "d4d1pu",
          "type": "image",
          "image": "pjotr happy",
          "side": "center"
        },
        {
          "id": "v9jr91",
          "type": "music",
          "music": "ayaya.ogg"
        },
        {
          "id": "xsk8lf",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "Good morning to class. Today is different day because we will not perform lecture.",
          "side": "center"
        },
        {
          "id": "b42q5l",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "Students will take trip to local amusement park. We are conducting team building exercise to make life-long connections.",
          "side": "center"
        },
        {
          "id": "bn63is",
          "type": "raw",
          "raw_code": "hide pjotr",
          "_isSkipped": true
        },
        {
          "id": "x1kqtf",
          "type": "image",
          "image": "bloodstain neutral",
          "side": "center"
        },
        {
          "id": "pmuphe",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Pssh, how ridiculous. There's no merit in childish flights of fancy.",
          "side": "center"
        },
        {
          "id": "ez9s6z",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Shame on our sensei for wasting our valuable tuition dollars on something so meaningless.",
          "side": "center"
        },
        {
          "id": "mhnfuo",
          "type": "image",
          "image": "swimsuit saber",
          "side": "right"
        },
        {
          "id": "tv1iqu",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "I had better make the most of our brief time on campus, lest I discover this theme park has no wi-fi access.",
          "side": "center"
        },
        {
          "id": "9vd6l2",
          "type": "narration",
          "text": "You, and the rest of the class, leave the school for the field trip."
        },
        {
          "id": "gxg41v",
          "type": "bg",
          "bg": "bg leskoland"
        },
        {
          "id": "hbmfhx",
          "type": "image",
          "image": "lesko normal",
          "side": "center"
        },
        {
          "id": "0nv3a3",
          "type": "music",
          "music": "metrocross.ogg"
        },
        {
          "id": "9u7jtg",
          "type": "dialogue",
          "char_id": "2dx2s0u7",
          "pose": "neutral",
          "text": "Heya folks, I'm Matthew Lesko, and I'm here to proudly present the grand opening of my new theme park, Lesko Land!",
          "side": "center"
        },
        {
          "id": "r61i4q",
          "type": "dialogue",
          "char_id": "2dx2s0u7",
          "pose": "neutral",
          "text": "It's been my dream since I was just a little Lesko to open up an amusement park, and today, with the help of numerous government grants, that dream is finally coming true.",
          "side": "center"
        },
        {
          "id": "uet1c3",
          "type": "dialogue",
          "char_id": "2dx2s0u7",
          "pose": "neutral",
          "text": "So step on in, and let Lesko Land give you the freedom to do whatever your heart desires.",
          "side": "center"
        },
        {
          "id": "53mk9j",
          "type": "raw",
          "raw_code": "hide lesko",
          "_isSkipped": true
        },
        {
          "id": "dxdy2o",
          "type": "image",
          "image": "pjotr happy",
          "side": "center"
        },
        {
          "id": "673v3e",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "Please students, I must request that you do not do whatever your hearts desires. We are representing school and must follow strict behavioral conduct.",
          "side": "center"
        },
        {
          "id": "nuwg96",
          "type": "raw",
          "raw_code": "hide pjotr",
          "_isSkipped": true
        },
        {
          "id": "ohnv5w",
          "type": "image",
          "image": "bloodstain neutral",
          "side": "center"
        },
        {
          "id": "prjyde",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "So... it's just a bunch of pipes?",
          "side": "center"
        },
        {
          "id": "ipgw4r",
          "type": "image",
          "image": "bloodstain neutral",
          "side": "left"
        },
        {
          "id": "hjhzx9",
          "type": "image",
          "image": "old man",
          "side": "right"
        },
        {
          "id": "siao7h",
          "type": "dialogue",
          "char_id": "swmds8hs",
          "pose": "neutral",
          "text": "Mostly, yes, but there are also valves and grates.",
          "side": "center"
        },
        {
          "id": "cb5cyb",
          "type": "dialogue",
          "char_id": "swmds8hs",
          "pose": "neutral",
          "text": "Now students, if you'd like a tour of the facility, please follow me. Our first stop is the Emulsion Station.",
          "side": "center"
        },
        {
          "id": "1smlkg",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Only a true baka would be interested in such foolishness. Come on Mario, let's check if they left the password on the router.",
          "side": "center"
        },
        {
          "id": "3yonj8",
          "type": "narration",
          "text": "You decide to follow Bloodstain while the rest of the class tours Lesko Land."
        },
        {
          "id": "9x0m0m",
          "type": "raw",
          "raw_code": "hide old man",
          "_isSkipped": true
        },
        {
          "id": "h8rg7y",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "What a joke. I can hardly fathom how our presitigous academy was swindled by that four-eyed conman.",
          "side": "center"
        },
        {
          "id": "t1y15p",
          "type": "narration",
          "text": "???\" \"Wonderful, wonderful. The plan is proceeding just as scheduled."
        },
        {
          "id": "ht42ci",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Hold on, I think I hear someone coming.",
          "side": "center"
        },
        {
          "id": "goqcck",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Strange, everyone should be on the tour. Who else is here with us?",
          "side": "center"
        },
        {
          "id": "9whafv",
          "type": "image",
          "image": "moneybags neutral",
          "side": "right"
        },
        {
          "id": "qvadiw",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "Mario? What are you doing here? If you've come to renegotiate, I'm afraid I've already secured the necessary funds elsewhere.",
          "side": "center"
        },
        {
          "id": "67ty4u",
          "type": "image",
          "image": "bloodstain katana",
          "side": "center"
        },
        {
          "id": "27ojea",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Kisama......... You'll pay for crossing the Pitchford clan, Moneybags!",
          "side": "center"
        },
        {
          "id": "t7urkd",
          "type": "narration",
          "text": "Bloodstain raises his katana at Moneybags. You step in front of him, demanding he explain himself."
        },
        {
          "id": "w1p3jo",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Mario, this demon stole my family's money hoard and used it to buy a wrestling ring downtown! He's the reason I came to this town in the first place.",
          "side": "center"
        },
        {
          "id": "bqv76s",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Greedy, narcissistic monsters like him need to be stricken down!",
          "side": "center"
        },
        {
          "id": "5dzdlf",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "Your money hoard? Ah, so you're the son of Pitchford. You know, the Megalomaniacs For the Greater Good could use an assassin of your talent.",
          "side": "center"
        },
        {
          "id": "mppmmv",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "What do you say, boy? Join me, and together we'll rule Japan.",
          "side": "center"
        },
        {
          "id": "7p3dzd",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "I'll never join you!",
          "side": "center"
        },
        {
          "id": "hpyfjt",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Now what in the gat'dang heck is going on here?",
          "side": "center"
        },
        {
          "id": "my3i2b",
          "type": "image",
          "image": "hank determined",
          "side": "center"
        },
        {
          "id": "kvj2g0",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Mario? You're supposed to be in school!",
          "side": "center"
        },
        {
          "id": "o49pq9",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "A keyblade? You must be the one who's been destroying my Heartless!",
          "side": "center"
        },
        {
          "id": "oq7i0d",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Your Heartless? What kinda yellow-bellied fiend would summon creatures of darkness to this sweet town?",
          "side": "center"
        },
        {
          "id": "wz1k4m",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Only a demon with a heart blacker than the deepest darkness.",
          "side": "center"
        },
        {
          "id": "thvugt",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Well son, I'm still not sure what in the sam-hill is going on here, but my pop always told me: the enemy of my enemy is my friend.",
          "side": "center"
        },
        {
          "id": "3bdj5o",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Hai. I would be honored to fight alongside a keyblade wielder.",
          "side": "center"
        },
        {
          "id": "9n0yv0",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "I won't be taken down that easily! Bring out Lesko!",
          "side": "center"
        },
        {
          "id": "3w6i7w",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Lesko?!",
          "side": "center"
        },
        {
          "id": "bx2e2o",
          "type": "image",
          "image": "old man at rightish",
          "side": "center"
        },
        {
          "id": "7xpjmm",
          "type": "image",
          "image": "hank determined at leftish",
          "side": "center"
        },
        {
          "id": "r05iyp",
          "type": "image",
          "image": "lesko normal",
          "side": "center"
        },
        {
          "id": "v9chdt",
          "type": "dialogue",
          "char_id": "swmds8hs",
          "pose": "neutral",
          "text": "As you command, Moneybags.",
          "side": "center"
        },
        {
          "id": "a43vuu",
          "type": "narration",
          "text": "The old man from earlier runs to the scene, with Matthew Lesko close behind. Lesko seems distant, as if in a trance."
        },
        {
          "id": "8ecmoz",
          "type": "dialogue",
          "char_id": "swmds8hs",
          "pose": "neutral",
          "text": "Show them your true power, Lesko!",
          "side": "center"
        },
        {
          "id": "vxwiry",
          "type": "image",
          "image": "chaos emeralds",
          "side": "center"
        },
        {
          "id": "97qa15",
          "type": "narration",
          "text": "The old man pulls a set of gems from his pockets. The gems float towards Lesko, as if drawn to him."
        },
        {
          "id": "g6xt2y",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "The chaos emeralds?! Gat'dangit!",
          "side": "center"
        },
        {
          "id": "myg2cm",
          "type": "raw",
          "raw_code": "hide chaos emeralds",
          "_isSkipped": true
        },
        {
          "id": "xreucp",
          "type": "image",
          "image": "lesko super",
          "side": "center"
        },
        {
          "id": "mr7psv",
          "type": "music",
          "music": "metro2.ogg"
        },
        {
          "id": "zl8fwn",
          "type": "dialogue",
          "char_id": "8d0mg00z",
          "pose": "neutral",
          "text": "HYAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
          "side": "center"
        },
        {
          "id": "4wc6lr",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "I'm sorry Mario, but I believe this will be our last meeting. I did treasure our friendship, once, but I've moved on to bigger and better things. Farewell.",
          "side": "center"
        },
        {
          "id": "id6b4o",
          "type": "raw",
          "raw_code": "hide moneybags",
          "_isSkipped": true
        },
        {
          "id": "coc68i",
          "type": "narration",
          "text": "Moneybags flees the scene. Bloodstain attacks, but Super Lesko blocks his katana with one hand. He then tosses Bloodstain across the room, and pulls his arm back for a punch."
        },
        {
          "id": "y1ji11",
          "type": "dialogue",
          "char_id": "8d0mg00z",
          "pose": "neutral",
          "text": "Admonishing Knuckle!",
          "side": "center"
        },
        {
          "id": "he2ed8",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Aaaaaiiiiieeee!",
          "side": "center"
        },
        {
          "id": "ztvech",
          "type": "image",
          "image": "pjotr happy",
          "side": "right"
        },
        {
          "id": "fq0e5x",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "What is happening now on field trip? We are to give kids bonding experience and now question mark man is engaging in mortal combat with student!",
          "side": "center"
        },
        {
          "id": "gnb77z",
          "type": "narration",
          "text": "Peter Pjotr offers Bloodstain a hand. After a moment's hesitation, Bloodstain accepts."
        },
        {
          "id": "q0neyu",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "You gotta snap out of it, Lesko!",
          "side": "center"
        },
        {
          "id": "iqeu9c",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "He seems unlikely to stop with the destruction. I do not think asking will help now.",
          "side": "center"
        },
        {
          "id": "8nr87t",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Dangit, Lesko! I didn't want to do this! Hallowed Mirror Blade!",
          "side": "center"
        },
        {
          "id": "vqa0vs",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "This one's from dad! Supreme Slash End!",
          "side": "center"
        },
        {
          "id": "nqrg10",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "I will not let theme park mascot harm students! Flaming Vortex Chunker!",
          "side": "center"
        },
        {
          "id": "a37asx",
          "type": "choice",
          "prompt": "",
          "opts": [
            {
              "id": "v090b1",
              "text": "Black Hole Burst!",
              "scene": "6xerds"
            },
            {
              "id": "d2rmrz",
              "text": "Unlimited Big Brutal Burning Bodacious Break Buster!",
              "scene": "6xerds"
            }
          ]
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "6xerds",
      "label": "lesko_defeated",
      "bg": null,
      "music": "metrocross.ogg",
      "events": [
        {
          "id": "24pse4",
          "type": "music",
          "music": ""
        },
        {
          "id": "qx264j",
          "type": "dialogue",
          "char_id": "8d0mg00z",
          "pose": "neutral",
          "text": "AAAAAAAAAAARGH",
          "side": "center"
        },
        {
          "id": "js85pi",
          "type": "image",
          "image": "chaos emeralds",
          "side": "center"
        },
        {
          "id": "h21qb0",
          "type": "wait",
          "dur": 2
        },
        {
          "id": "di02wv",
          "type": "raw",
          "raw_code": "hide chaos emeralds",
          "_isSkipped": true
        },
        {
          "id": "o4n9gy",
          "type": "wait",
          "dur": 2
        },
        {
          "id": "sqs1gr",
          "type": "image",
          "image": "lesko normal",
          "side": "center"
        },
        {
          "id": "r86j8m",
          "type": "music",
          "music": "metrocross.ogg"
        },
        {
          "id": "xh5iww",
          "type": "dialogue",
          "char_id": "swmds8hs",
          "pose": "neutral",
          "text": "You were able to overcome the power of the chaos emeralds? Impossible!",
          "side": "center"
        },
        {
          "id": "cdvxs5",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "-huff, huff- I think we did it.",
          "side": "center"
        },
        {
          "id": "ct6ngo",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "Not quite. Man is weakened, but is still able to fight.",
          "side": "center"
        },
        {
          "id": "yzq4q0",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "My katana, Battleborn, can exinguish his life in a moment's notice.",
          "side": "center"
        },
        {
          "id": "dnh8yl",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Now just hold on a dang minute! He's no threat to us now. Just let the man go in peace.",
          "side": "center"
        },
        {
          "id": "nul0v8",
          "type": "choice",
          "prompt": "",
          "opts": [
            {
              "id": "mnf2zp",
              "text": "We should let him go.",
              "scene": "1ouafm"
            },
            {
              "id": "vrvg94",
              "text": "He's too dangerous to be spared.",
              "scene": "s95b8j"
            }
          ]
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "s95b8j",
      "label": "hank_bad",
      "bg": null,
      "music": null,
      "events": [
        {
          "id": "he1n89",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "I agree. With that much power, he could've destroyed the entire town.",
          "side": "center"
        },
        {
          "id": "dds9wt",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "No! Lesko!",
          "side": "center"
        },
        {
          "id": "p8ywhu",
          "type": "narration",
          "text": "You restrain Hank, while Bloodstain delivers the finishing blow."
        },
        {
          "id": "lwh45r",
          "type": "dialogue",
          "char_id": "swmds8hs",
          "pose": "neutral",
          "text": "That's my cue to split!",
          "side": "center"
        },
        {
          "id": "m98414",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "Spectacled dwarf man should stay until authorities arrive for questioning.",
          "side": "center"
        },
        {
          "id": "kva7v0",
          "type": "dialogue",
          "char_id": "swmds8hs",
          "pose": "neutral",
          "text": "...Alright, I surrender.",
          "side": "center"
        },
        {
          "id": "46cv5e",
          "type": "jump",
          "scene_id": "o42o84",
          "transition": "dissolve",
          "_targetLabel": "leskoland_end"
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "1ouafm",
      "label": "hank_good",
      "bg": null,
      "music": null,
      "events": [
        {
          "id": "huz7qs",
          "type": "raw",
          "raw_code": "$ hank_flag = True"
        },
        {
          "id": "6n8ukb",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "...Hmph, fine. Battleborn's thirst for blood will remain unquenched, this day.",
          "side": "center"
        },
        {
          "id": "x49n3k",
          "type": "image",
          "image": "bloodstain neutral",
          "side": "center"
        },
        {
          "id": "nkif1v",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "We will take glowing super villain and elderly man to nearby prison.",
          "side": "center"
        },
        {
          "id": "bjysbp",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Thank you, Mario. I knew you had a good head on your shoulders.",
          "side": "center"
        },
        {
          "id": "gud43n",
          "type": "dialogue",
          "char_id": "2dx2s0u7",
          "pose": "neutral",
          "text": "Hank? Is that you?",
          "side": "center"
        },
        {
          "id": "ar98wb",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "It's me, Lesko! It's your old buddy, Hank Hill! I've been looking all over for ya!",
          "side": "center"
        },
        {
          "id": "jg1t1y",
          "type": "jump",
          "scene_id": "o42o84",
          "transition": "none",
          "_targetLabel": "leskoland_end"
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "o42o84",
      "label": "leskoland_end",
      "bg": "bg kitchen",
      "music": "recet1.ogg",
      "events": [
        {
          "id": "wvcui4",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "Students should return to group until end of field trip.",
          "side": "center"
        },
        {
          "id": "m59p2f",
          "type": "narration",
          "text": "You and Bloodstain walk back to meet your classmates."
        },
        {
          "id": "cpsjhy",
          "type": "music",
          "music": "recet2.ogg"
        },
        {
          "id": "zlgvpi",
          "type": "bg",
          "bg": "bg leskoland"
        },
        {
          "id": "d9vcyq",
          "type": "image",
          "image": "bloodstain neutral",
          "side": "center"
        },
        {
          "id": "702bzk",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "So, MFGG was behind Lesko Land too.",
          "side": "center"
        },
        {
          "id": "ywbj85",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "MFGG, the Megalomaniacs For the Greater Good, have been wreaking havoc all across Japan for the past few months. When their leader, Moneybags, stole my family's money hoard, I vowed to take them down at any cost.",
          "side": "center"
        },
        {
          "id": "soqy7e",
          "type": "narration",
          "text": "You tell Bloodstain what happened yesterday, at the wrestling ring."
        },
        {
          "id": "606n1p",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "The Heartless, huh? So that's their plan...",
          "side": "center"
        },
        {
          "id": "xmfw0v",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Mario, these attacks won't stop unless someone takes Moneybags down. I was planning on fighting on my own, but you've proven a valuable ally. Would you join my quest?",
          "side": "center"
        },
        {
          "id": "sliiv3",
          "type": "narration",
          "text": "Bloodstain offers you his hand. You give him a firm handshake, and nod in approval."
        },
        {
          "id": "5vf2vq",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Sugoi. Our battle went well today. Let's rest, and discuss our plans tomorrow.",
          "side": "center"
        },
        {
          "id": "67ff87",
          "type": "bg",
          "bg": "bg house"
        },
        {
          "id": "zqzbm3",
          "type": "wait",
          "dur": 2
        },
        {
          "id": "kypz8y",
          "type": "bg",
          "bg": "bg room"
        },
        {
          "id": "aai7wa",
          "type": "music",
          "music": "recet1.ogg"
        },
        {
          "id": "0xcdv4",
          "type": "narration",
          "text": "You return home from the field trip, and go to bed early that night."
        },
        {
          "id": "p9d28m",
          "type": "bg",
          "bg": "bg kitchen"
        },
        {
          "id": "2eb5e1",
          "type": "if",
          "condition": "hank_flag",
          "scene_true": "2ustun",
          "scene_false": "pwxuze"
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "pwxuze",
      "label": "leskoland_end_bad_end",
      "bg": "bg tombstone",
      "music": "recet1.ogg",
      "events": [
        {
          "id": "m79yip",
          "type": "image",
          "image": "hank determined",
          "side": "center"
        },
        {
          "id": "1ue0gn",
          "type": "narration",
          "text": "The next morning, you wake up early to talk to Hank."
        },
        {
          "id": "056itx",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Oh, it's you, Mario.",
          "side": "center"
        },
        {
          "id": "bi5sbb",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "I'm not much in the mood for small talk today.",
          "side": "center"
        },
        {
          "id": "mvlin1",
          "type": "narration",
          "text": "You tell Hank about MFGG, and about your encounters with Moneybags."
        },
        {
          "id": "hbalcg",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "MFGG? Those gosh darn bastards will pay for this.",
          "side": "center"
        },
        {
          "id": "9d8x2q",
          "type": "raw",
          "raw_code": "hide hank",
          "_isSkipped": true
        },
        {
          "id": "l1320m",
          "type": "narration",
          "text": "Hank rushes out to his car before you can say another word. You watch from the kitchen window as he drives off into town."
        },
        {
          "id": "320dhn",
          "type": "music",
          "music": ""
        },
        {
          "id": "v27lw8",
          "type": "bg",
          "bg": "bg tombstone"
        },
        {
          "id": "sgjele",
          "type": "narration",
          "text": "Later, you discover that Hank died in battle. Without Hank's help, you're unable to stop Moneybags. So ends your adventure."
        },
        {
          "id": "miztzs",
          "type": "wait",
          "dur": 2
        },
        {
          "id": "viadt6",
          "type": "jump",
          "scene_id": null,
          "_isReturn": true
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "2ustun",
      "label": "happy_hank",
      "bg": "bg house",
      "music": null,
      "events": [
        {
          "id": "jtctex",
          "type": "image",
          "image": "hank friendly",
          "side": "center"
        },
        {
          "id": "neqxwl",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Mornin'! That was a pretty dang hairy situation yesterday, buddy! Glad you're on my side.",
          "side": "center"
        },
        {
          "id": "eaj0sp",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Y'know, I've been looking for Lesko this entire time. We used to fight side by side, but just last year he was all Heartless this and darkness that.",
          "side": "center"
        },
        {
          "id": "dkzyem",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "I tracked him to this town, but yesterday was the first time I'd seen him in months. I'm still not sure what the heck happened.",
          "side": "center"
        },
        {
          "id": "ls3ccs",
          "type": "narration",
          "text": "You tell Hank about MFGG, and about your encounters with Moneybags."
        },
        {
          "id": "cn08it",
          "type": "image",
          "image": "hank determined",
          "side": "center"
        },
        {
          "id": "dcstfa",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "So they're the ones behind all this. If they keep releasing Heartless, the world could be in a real pickle.",
          "side": "center"
        },
        {
          "id": "qs6btc",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "I have some idea as to where we can find this Moneybags fellow.",
          "side": "center"
        },
        {
          "id": "omwo1y",
          "type": "image",
          "image": "hank friendly",
          "side": "center"
        },
        {
          "id": "r5uu4g",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "But this time, we'll be workin' together. Right, buddy?",
          "side": "center"
        },
        {
          "id": "7zaaay",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "When I find MFGG Headquarters, I'll give you a phone call. 'Till then, you should stay in school.",
          "side": "center"
        },
        {
          "id": "arg9ic",
          "type": "bg",
          "bg": "bg house"
        },
        {
          "id": "2oy13w",
          "type": "narration",
          "text": "You and Hank walk outside together, and wave goodbye as you part ways."
        },
        {
          "id": "zox64z",
          "type": "if",
          "condition": "takagi_flag",
          "scene_true": "9cqh77",
          "scene_false": "zz3igz"
        },
        {
          "id": "63jr9p",
          "type": "jump",
          "scene_id": "9cqh77",
          "transition": "none",
          "_targetLabel": "takagi_serious"
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "9cqh77",
      "label": "takagi_serious",
      "bg": null,
      "music": "happy.ogg",
      "events": [
        {
          "id": "s3ya24",
          "type": "music",
          "music": "happy.ogg"
        },
        {
          "id": "5stwkp",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "ay neighbour what's good lol",
          "side": "center"
        },
        {
          "id": "04ied9",
          "type": "image",
          "image": "takagi ok",
          "side": "center"
        },
        {
          "id": "ob0n2f",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "you got this stone cold serious look on your face, like robocop. or like robocop 3",
          "side": "center"
        },
        {
          "id": "5nmr5p",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "lemme see your phone for a sec.",
          "side": "center"
        },
        {
          "id": "etznxs",
          "type": "image",
          "image": "cellphone",
          "side": "left"
        },
        {
          "id": "ylk847",
          "type": "narration",
          "text": "You hand Takagi your phone. She struggles to hold it, but manages to key a number in and hand it back to you."
        },
        {
          "id": "9d4k8y",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "there. i'm numero oneo on your speed dial, gimme a call if you need anything. neighbours gotta stick together.",
          "side": "center"
        },
        {
          "id": "sbezlv",
          "type": "raw",
          "raw_code": "hide cellphone",
          "_isSkipped": true
        },
        {
          "id": "81gko7",
          "type": "narration",
          "text": "You thank Takagi, and say your goodbyes as you board the bus."
        },
        {
          "id": "5bbc1b",
          "type": "raw",
          "raw_code": "hide takagi",
          "_isSkipped": true
        },
        {
