          "side": "center"
        },
        {
          "id": "u5aagz",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "the Nitro box from an inferior Playstation platformer,",
          "side": "center"
        },
        {
          "id": "3yo9j7",
          "type": "image",
          "image": "danger sandal",
          "side": "center"
        },
        {
          "id": "tt26m5",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "and an ugly sandal,",
          "side": "center"
        },
        {
          "id": "1tmbq6",
          "type": "image",
          "image": "danger uno",
          "side": "center"
        },
        {
          "id": "dlr4fy",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "and play this card to give it plus 4 to all attributes!",
          "side": "center"
        },
        {
          "id": "j52y9c",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "dude that's not how the card works. you can't just make stuff up like that and expect us to go with it",
          "side": "center"
        },
        {
          "id": "qu7h01",
          "type": "raw",
          "raw_code": "hide danger",
          "_isSkipped": true
        },
        {
          "id": "ukclab",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "It doesn't matter! The ritual is complete!",
          "side": "center"
        },
        {
          "id": "g9evdo",
          "type": "raw",
          "raw_code": "hide krabs",
          "_isSkipped": true
        },
        {
          "id": "9hs3np",
          "type": "raw",
          "raw_code": "hide hank",
          "_isSkipped": true
        },
        {
          "id": "j8wnsr",
          "type": "raw",
          "raw_code": "hide takagi",
          "_isSkipped": true
        },
        {
          "id": "lzj1bi",
          "type": "raw",
          "raw_code": "hide void",
          "_isSkipped": true
        },
        {
          "id": "7slgl0",
          "type": "raw",
          "raw_code": "hide bloodstain",
          "_isSkipped": true
        },
        {
          "id": "iu28rd",
          "type": "raw",
          "raw_code": "hide moneybags",
          "_isSkipped": true
        },
        {
          "id": "ud0n7b",
          "type": "raw",
          "raw_code": "show danger heartless:"
        },
        {
          "id": "y85ulz",
          "type": "music",
          "music": ""
        },
        {
          "id": "l36at1",
          "type": "wait",
          "dur": 2
        },
        {
          "id": "nrql1z",
          "type": "music",
          "music": "mmsf.ogg"
        },
        {
          "id": "ttyz7a",
          "type": "dialogue",
          "char_id": "y9vbt1yp",
          "pose": "neutral",
          "text": "RRRRRRRRAAAAAAAAAAAAHHH",
          "side": "center"
        },
        {
          "id": "p8rvoa",
          "type": "narration",
          "text": "The Heartless marches forward, slashing, punching and shooting in all directions. The group is able to evade its attacks, but none of them have a chance to strike back."
        },
        {
          "id": "jir1ss",
          "type": "image",
          "image": "hank determined at left behind danger",
          "side": "center"
        },
        {
          "id": "hxq7xo",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Dagnabbit! I've never fought one this powerful before!",
          "side": "center"
        },
        {
          "id": "jwdw1j",
          "type": "image",
          "image": "pjotr happy at right behind danger",
          "side": "center"
        },
        {
          "id": "79sw78",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "I have feeling ordinary bullets will be insufficient to slay magical giant monster.",
          "side": "center"
        },
        {
          "id": "1wv5qr",
          "type": "image",
          "image": "takagi smug at rightish behind danger",
          "side": "center"
        },
        {
          "id": "3ewq40",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "are you guys serious? you didn't have any plan to beat this thing?",
          "side": "center"
        },
        {
          "id": "c13zky",
          "type": "image",
          "image": "krabs neutral at right behind danger",
          "side": "center"
        },
        {
          "id": "5e41qt",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Step aside, I can take him! One uppercut to the chin and this thing'll be pushing up daisies!",
          "side": "center"
        },
        {
          "id": "04ssaw",
          "type": "image",
          "image": "void neutral at leftish behind danger",
          "side": "center"
        },
        {
          "id": "l3rem9",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "You can't even reach its chin, I've seen dogs taller than you. Now everybody shut up, I have a plan.",
          "side": "center"
        },
        {
          "id": "cmk3w6",
          "type": "image",
          "image": "bloodstain katana at rightish behind danger",
          "side": "center"
        },
        {
          "id": "u5hlwk",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Void-chan?! You can beat this thing?",
          "side": "center"
        },
        {
          "id": "1kyf61",
          "type": "music",
          "music": "spyro.ogg"
        },
        {
          "id": "1z64q8",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "No but I can send it back to where it came. All I need is to draw a simple magic circle, and touch him while standing in it.",
          "side": "center"
        },
        {
          "id": "eyf2d4",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "dude he's not exactly gonna give you a high five lol. does anyone have a better plan?",
          "side": "center"
        },
        {
          "id": "knh53o",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Hold on now, Takagi. This might be our only chance.",
          "side": "center"
        },
        {
          "id": "n1y11d",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "Obviously if I just stand in its path and start drawing I'm going to get a 3000 degree knife right in the darkness. That's why you guys are going to push him into it.",
          "side": "center"
        },
        {
          "id": "qn4l3s",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "If that's what it takes, so be it.",
          "side": "center"
        },
        {
          "id": "dsmel0",
          "type": "image",
          "image": "moneybags space at right behind danger",
          "side": "center"
        },
        {
          "id": "lhn1ew",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "Keep up the good work, Heartless! If you kill the lot of them, I'll promote you to Chief Executive Officer of Murder! You'll still be paid the same, but it's a highly sought after position!",
          "side": "center"
        },
        {
          "id": "2q0u83",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "You need to distract it while I sneak behind. From there, I'll give the signal and you need to push him back as hard as you can. Got it?",
          "side": "center"
        },
        {
          "id": "j8nru7",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Well sure, but-",
          "side": "center"
        },
        {
          "id": "nj51g6",
          "type": "raw",
          "raw_code": "hide void",
          "_isSkipped": true
        },
        {
          "id": "7y8ym3",
          "type": "narration",
          "text": "Void-chan slinks into the ground, as little more than a black puddle, and disappears behind the giant Heartless."
        },
        {
          "id": "101nzg",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Everyone fan out! We need to prevent our opponent from gaining any ground, or the battle will be lost.",
          "side": "center"
        },
        {
          "id": "a0g7sr",
          "type": "narration",
          "text": "You and the group split up, dividing the Heartless's attention between the six of you. It can't seem to process multiple targets, and stops advancing, instead attacking each of you in turn."
        },
        {
          "id": "d03d7r",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "u know i wasn't really told we were going to fight a big monster thing today. i would've, idk, stretched first or something.",
          "side": "center"
        },
        {
          "id": "ctab4k",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "We need only hold out until little blob girl finishes vandalizing ground.",
          "side": "center"
        },
        {
          "id": "gp4zn7",
          "type": "narration",
          "text": "From behind the Heartless, a massive pillar of darkness shoots up and disperses amongst the stars."
        },
        {
          "id": "0vuu1r",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "That was the signal, by the way!",
          "side": "center"
        },
        {
          "id": "culwfx",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Alright, y'all, we'll need to smack the dang thing all at the exact same time to push it back far enough.",
          "side": "center"
        },
        {
          "id": "7948up",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Of course. Begin synchronized assault!",
          "side": "center"
        },
        {
          "id": "g30fg5",
          "type": "narration",
          "text": "You, Hank, Takagi, Bloodstain, Mr. Krabs and Peter Pjotr all leap into the air, using the moon's low gravity to rise above the giant Heartless."
        },
        {
          "id": "ttn7nl",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "BIII",
          "side": "center"
        },
        {
          "id": "ftb06e",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "BIIIIIIIIG",
          "side": "center"
        },
        {
          "id": "g30gkf",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "BIIIIIIIIG KIIII",
          "side": "center"
        },
        {
          "id": "h1f6yo",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "BIIIIIIIIG KIIIIIII",
          "side": "center"
        },
        {
          "id": "wbtj0p",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "BIIIIIIIIG KIIIIIIIIIIII",
          "side": "center"
        },
        {
          "id": "f9j7o3",
          "type": "narration",
          "text": "All\" \"BIIIIIIIIG KIIIIIIIIIIIICK!!!!!"
        },
        {
          "id": "e3qec6",
          "type": "narration",
          "text": "You all deliver a mighty kick to the Heartless' head. Its tall, weak legs are unable to maintain balance and it stumbles backwards."
        },
        {
          "id": "ohfquz",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Well, did we get 'im?",
          "side": "center"
        },
        {
          "id": "john24",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "Dangerous creature is still here, so we have not yet succeeded in plan.",
          "side": "center"
        },
        {
          "id": "k2af0z",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "I'm a few inches too short! It's hard to reach forward when you don't have arms!",
          "side": "center"
        },
        {
          "id": "1rkvr9",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Dagnabbit, we didn't push it back far enough!",
          "side": "center"
        },
        {
          "id": "u1z4bm",
          "type": "music",
          "music": "yugioh.ogg"
        },
        {
          "id": "9gd9fm",
          "type": "narration",
          "text": "Your adventure is nearly at an end. If you can prevent the monster from reaching Earth, you may change the fate of the entire planet. What is your next move?"
        },
        {
          "id": "gqiban",
          "type": "choice",
          "prompt": "",
          "opts": [
            {
              "id": "j31l7f",
              "text": "Jump on it.",
              "scene": "0u1xsp",
              "is_correct": true
            },
            {
              "id": "nkh9nz",
              "text": "Do nothing.",
              "scene": "lquxtx",
              "is_incorrect": true
            }
          ]
        }
      ],
      "ending_type": "true"
    },
    {
      "id": "lquxtx",
      "label": "bad_end",
      "bg": null,
      "music": null,
      "events": [
        {
          "id": "hevroc",
          "type": "narration",
          "text": "You were unable to defeat the Heartless, and were slain in battle. Without anyone left to oppose him, Moneybags is free to take over the world, and establish a monopoly on overpriced niche products. So ends your adventure."
        },
        {
          "id": "3ifnda",
          "type": "jump",
          "scene_id": null,
          "_isReturn": true
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "0u1xsp",
      "label": "good_end",
      "bg": "bg alley",
      "music": "recet2.ogg",
      "events": [
        {
          "id": "8hrj9f",
          "type": "narration",
          "text": "You decide to jump on it, because hey, you're Mario."
        },
        {
          "id": "xpdslb",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "Got it!",
          "side": "center"
        },
        {
          "id": "2kzhn6",
          "type": "wait",
          "dur": 2
        },
        {
          "id": "o6y66m",
          "type": "raw",
          "raw_code": "hide danger",
          "_isSkipped": true
        },
        {
          "id": "o49dea",
          "type": "image",
          "image": "void happy",
          "side": "center"
        },
        {
          "id": "w61pq8",
          "type": "narration",
          "text": "The instant your feet finish contacting the Heartless, a wave of darkness swirls up from behind and engulfs it. In seconds it disappears from sight. You see Void-chan standing roughly it its place."
        },
        {
          "id": "igjvqn",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "That was fun! Who are we fighting next? I think I could probably take out the little girl, if you guys held her down.",
          "side": "center"
        },
        {
          "id": "pcej2p",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "No, Void-chan. Our next target is that demon, possessed by greed.",
          "side": "center"
        },
        {
          "id": "e7qbpa",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "Oh! You've defeated my Heartless. Well, it was nice of us to get together, it's been so long since we've done this, old friend, but I really must be going!",
          "side": "center"
        },
        {
          "id": "rnx6eo",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Heck no! We're taking you in, y'dang creep!",
          "side": "center"
        },
        {
          "id": "1gmmp2",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "I agree. Dog who seeks to harm students should be put in cage.",
          "side": "center"
        },
        {
          "id": "m04n1l",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Right, good initiative, soliders! Bring him in and lets turn him in for the reward money!",
          "side": "center"
        },
        {
          "id": "wsj9et",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "i don't think there's any reward. tbh i'm not sure anything we've done today is legal at all.",
          "side": "center"
        },
        {
          "id": "ouswv9",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "Shut up! Of course there's a reward! Lobster guy, you carry him on-board and we'll give you the biggest share!",
          "side": "center"
        },
        {
          "id": "lxfgw1",
          "type": "image",
          "image": "krabs greedy",
          "side": "center"
        },
        {
          "id": "nsiok0",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Move aside! Ol' Captain Krabs can handle one criminal no problem!",
          "side": "center"
        },
        {
          "id": "9vz1dz",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Moneybags, you will repay my clan for every yen stolen from their money hoard. Either in currency, or in blood.",
          "side": "center"
        },
        {
          "id": "ohdxjb",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "Alright, currency! Wait, blood! No, currency!",
          "side": "center"
        },
        {
          "id": "8r7w4e",
          "type": "narration",
          "text": "You and the group board Takagi's spacecraft. She waves goodbye to the astronauts and escorts you back to Japan."
        },
        {
          "id": "zfbaz7",
          "type": "bg",
          "bg": "bg alley"
        },
        {
          "id": "60sa7b",
          "type": "music",
          "music": "recet2.ogg"
        },
        {
          "id": "itzlwj",
          "type": "image",
          "image": "takagi ok",
          "side": "center"
        },
        {
          "id": "930dm5",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "we've arrived at our destination, please exit in an orderly fashion. thx for flying takagi airlines",
          "side": "center"
        },
        {
          "id": "cf2xl5",
          "type": "image",
          "image": "pjotr happy",
          "side": "right"
        },
        {
          "id": "itl40p",
          "type": "image",
          "image": "moneybags neutral at rightish",
          "side": "center"
        },
        {
          "id": "bhrghy",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "I will escort criminal mastermind to police. Have good night, rest well and keep up with studies.",
          "side": "center"
        },
        {
          "id": "af0194",
          "type": "image",
          "image": "krabs greedy at leftish",
          "side": "center"
        },
        {
          "id": "kckgl0",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "And I'll escort the reward money into me pockets!",
          "side": "center"
        },
        {
          "id": "sttv4b",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "How could this be? I've lost everything: my money, my Heartless, my business! I was doing this all for the greater good! With no regulations, the free market could reach untold levels of prosperity!",
          "side": "center"
        },
        {
          "id": "6mcbxf",
          "type": "image",
          "image": "hank determined",
          "side": "left"
        },
        {
          "id": "szzb3o",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "That's all well and good, but y'brainwashed my friend Lesko and tried to kill us a bunch of times. You're a dang criminal, Moneybags.",
          "side": "center"
        },
        {
          "id": "5vovcc",
          "type": "raw",
          "raw_code": "hide krabs",
          "_isSkipped": true
        },
        {
          "id": "8mofi5",
          "type": "raw",
          "raw_code": "hide pjotr ",
          "_isSkipped": true
        },
        {
          "id": "mfqtlm",
          "type": "raw",
          "raw_code": "hide moneybags",
          "_isSkipped": true
        },
        {
          "id": "a89ho7",
          "type": "image",
          "image": "bloodstain neutral",
          "side": "right"
        },
        {
          "id": "g9c5yk",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "I was able to convince Moneybags to transfer his remaining money into my account. Battleborn can be very persuasive.",
          "side": "center"
        },
        {
          "id": "ufvelp",
          "type": "image",
          "image": "swimsuit saber",
          "side": "right"
        },
        {
          "id": "vuwnrp",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "And I pulled an extra 5-star. The mission was an overwhelming success, and it was all thanks to you, Mario.",
          "side": "center"
        },
        {
          "id": "c5lp45",
          "type": "raw",
          "raw_code": "hide swimsuit saber",
          "_isSkipped": true
        },
        {
          "id": "zj5kow",
          "type": "image",
          "image": "takagi smug",
          "side": "center"
        },
        {
          "id": "zwbrd1",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "k upvotes are cool and all but i was hoping for something a little more, idk, good, for saving the day",
          "side": "center"
        },
        {
          "id": "7tnmv3",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "We should do something together, my treat. Buddy, how d'ya want to celebrate our job well done?",
          "side": "center"
        },
        {
          "id": "jr9t0b",
          "type": "jump",
          "scene_id": "9rpmw7",
          "transition": "none",
          "_targetLabel": "final_choice"
        }
      ]
    },
    {
      "id": "9rpmw7",
      "label": "final_choice",
      "bg": null,
      "music": null,
      "events": [
        {
          "id": "bbyhjj",
          "type": "choice",
          "prompt": "",
          "opts": [
            {
              "id": "047prq",
              "text": "We should do a playground review.",
              "scene": "i3zxy0"
            },
            {
              "id": "xy30wl",
              "text": "We should play sports.",
              "scene": "y1g3xu"
            },
            {
              "id": "xyazh8",
              "text": "We should go to the arcade.",
              "scene": "3ei647"
            }
          ]
        }
      ]
    },
    {
      "id": "i3zxy0",
      "label": "playground_review",
      "bg": null,
      "music": null,
      "events": [
        {
          "id": "4h9utq",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "idk it's pretty sketch to go play on a playground in the middle of the night.",
          "side": "center"
        },
        {
          "id": "s19fhh",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Yeah, buddy, I'm gonna have to put a veto on that one. I'm not going to celebrate at a children's playground.",
          "side": "center"
        },
        {
          "id": "3532fc",
          "type": "narration",
          "text": "You try to convince them of the joy of a smooth slide, the exhiliration of the swingset, and the passionate fury you feel for meme wheels, but they're unconvinced."
        },
        {
          "id": "varexj",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Surely you can think of something else, Mario?",
          "side": "center"
        },
        {
          "id": "gyd6vk",
          "type": "jump",
          "scene_id": "9rpmw7",
          "transition": "dissolve",
          "_targetLabel": "final_choice"
        }
      ]
    },
    {
      "id": "y1g3xu",
      "label": "basketball_end",
      "bg": "cg basketball",
      "music": "jojo.ogg",
      "events": [
        {
          "id": "ckewa4",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "lmao let's do it! there's a court near here, i can show off my sick dunks",
          "side": "center"
        },
        {
          "id": "nyy28b",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Sounds like a plan. Y'know, I used to play center for my high school team.",
          "side": "center"
        },
        {
          "id": "gcc5yd",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Normally I avoid sports, other than martial arts and kendo, but I am willing to make an exception if you are all set on going.",
          "side": "center"
        },
        {
          "id": "ib5jch",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "then we're doing it! hurry up dudes it's almost past my bedtime",
          "side": "center"
        },
        {
          "id": "osq0l6",
          "type": "bg",
          "bg": "cg basketball"
        },
        {
          "id": "2aks2t",
          "type": "music",
          "music": "jojo.ogg"
        },
        {
          "id": "rvhgqq",
          "type": "narration",
          "text": "Charlesuke\" \"Welcome to the court! Let's have a GREAT game da ze~"
        },
        {
          "id": "b2ayw6",
          "type": "narration",
          "text": "You enjoy a game of basketball with some local athletes. So ends your adventure, a resounding success."
        },
        {
          "id": "n9kqoh",
          "type": "jump",
          "scene_id": "vrwz0s",
          "transition": "dissolve",
          "_targetLabel": "credits"
        }
      ]
    },
    {
      "id": "3ei647",
      "label": "arcade_end",
      "bg": "cg arcade",
      "music": null,
      "events": [
        {
          "id": "9wri4k",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Excellent choice. The local game center is open late, and can provide us with hours of amusement.",
          "side": "center"
        },
        {
          "id": "e1aque",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "i'm more into playstation but arcades are p. cool too.",
          "side": "center"
        },
        {
          "id": "2i3nwn",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Sure, you can spend a few tokens at the arcade, my treat. Just stay away from those dang violent games, they turn you into a psycho.",
          "side": "center"
        },
        {
          "id": "hpq5qu",
          "type": "bg",
          "bg": "cg arcade"
        },
        {
          "id": "0l6383",
          "type": "narration",
          "text": "You go to the arcade to celebrate with your friends. So ends your adventure, a resounding success."
        },
        {
          "id": "iwbz9f",
          "type": "jump",
          "scene_id": "vrwz0s",
          "transition": "dissolve",
          "_targetLabel": "credits"
        }
      ]
    },
    {
      "id": "vrwz0s",
      "label": "credits",
      "bg": "cg moneyhoard",
      "music": "forces.ogg",
      "events": [
        {
          "id": "ov8fgw",
          "type": "image",
          "image": "bg black",
          "side": "center"
        },
        {
          "id": "eh205b",
          "type": "narration",
          "text": "This piece of shit was written by Aidan for the Minus World Forums Gimmick Garrison."
        },
        {
          "id": "fnatfp",
          "type": "narration",
          "text": "Thanks to everyone who submitted suggestions. In order of first submission: Mariofan169, Superchao, Black, Draku, Fun with Despair, Elyk, Two_Finger, Brainwyrms, Jetamo and Snufferin Snugglepuss."
        },
        {
          "id": "4ocp6y",
          "type": "music",
          "music": ""
        },
        {
          "id": "2j0fic",
          "type": "narration",
          "text": "???\" \"And what of the money hoard?"
        },
        {
          "id": "bhskbs",
          "type": "bg",
          "bg": "cg moneyhoard"
        },
        {
          "id": "om6tnr",
          "type": "image",
          "image": "bloodstain katana",
          "side": "center"
        },
        {
          "id": "i36cpz",
          "type": "music",
          "music": "forces.ogg"
        },
        {
          "id": "9nlsm6",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "I got it back. All of it. With interest.",
          "side": "center"
        },
        {
          "id": "ahrdvf",
          "type": "narration",
          "text": "???\" \"With this much money, we can finally start work on our magnum opus: Battleborn 2. Excellent work, son."
        },
        {
          "id": "jku36l",
          "type": "wait",
          "dur": 2
        },
        {
          "id": "e2b1az",
          "type": "narration",
          "text": "The end."
        },
        {
          "id": "fn9v9m",
          "type": "jump",
          "scene_id": null,
          "_isReturn": true
        }
      ],
      "ending_type": "true"
    }
