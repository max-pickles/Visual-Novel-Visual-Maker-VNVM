          "side": "center"
        },
        {
          "id": "n4nzb9",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Me ex-wife?",
          "side": "center"
        },
        {
          "id": "dx7sl6",
          "type": "image",
          "image": "krabs neutral behind takagi",
          "side": "center"
        },
        {
          "id": "jwveb4",
          "type": "image",
