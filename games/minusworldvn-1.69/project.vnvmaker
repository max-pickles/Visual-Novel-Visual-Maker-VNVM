  "scenes": [
    {
      "id": "yt64cs",
      "label": "start",
      "bg": "bg roomdark",
      "music": "yugioh.ogg",
      "events": [
        {
          "id": "fbs30t",
          "type": "raw",
          "raw_code": "$ takagi_flag = False"
        },
        {
          "id": "ded7ue",
          "type": "raw",
          "raw_code": "$ krabs_flag = False"
        },
        {
          "id": "8idioh",
          "type": "raw",
          "raw_code": "$ void_flag = False"
        },
        {
          "id": "efptdo",
          "type": "raw",
          "raw_code": "$ hank_flag = False"
        },
        {
          "id": "ro3nr9",
          "type": "bg",
          "bg": "bg room"
        },
        {
          "id": "wozaxm",
          "type": "image",
          "image": "mario point",
          "side": "center"
        },
        {
          "id": "d0ami2",
          "type": "narration",
          "text": "One day, Mario woke up."
        },
        {
          "id": "278lve",
          "type": "music",
          "music": "yugioh.ogg"
        },
        {
          "id": "g5mzuj",
          "type": "bg",
          "bg": "bg roomdark"
        },
        {
          "id": "npuv9f",
          "type": "image",
          "image": "mario point",
          "side": "center"
        },
        {
          "id": "h3serx",
          "type": "narration",
          "text": "In this story, you take the role of Mario as he participates in an adventure beyond his understanding."
        },
        {
          "id": "ftwxc2",
          "type": "narration",
          "text": "You choices will help lead Mario to triumph, or to ruin."
        },
        {
          "id": "w0nzoc",
          "type": "narration",
          "text": "Can you accept this responsibility?"
        },
        {
          "id": "28et5u",
          "type": "choice",
          "prompt": "",
          "opts": [
            {
              "id": "gmdb3g",
              "text": "I can.",
              "scene": "ifd7e9"
            },
            {
              "id": "fwu6hi",
              "text": "I can not.",
              "scene": "ixmwfc"
            }
          ]
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "ixmwfc",
      "label": "intro_bad",
      "bg": null,
      "music": null,
      "events": [
        {
          "id": "xzg444",
          "type": "narration",
          "text": "Very well. Your adventure has ended before it began. Go on, in blissful ignorance of what lays in wait, just around the corner..."
        },
        {
          "id": "vltdvs",
          "type": "jump",
          "scene_id": null,
          "_isReturn": true
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "ifd7e9",
      "label": "intro_good",
      "bg": "bg kitchen",
      "music": "recet1.ogg",
      "events": [
        {
          "id": "0en4xg",
          "type": "narration",
          "text": "Excellent. With your permission, the story may begin, in earnest."
        },
        {
          "id": "sjipww",
          "type": "bg",
          "bg": "bg room"
        },
        {
          "id": "5gpx2p",
          "type": "music",
          "music": "recet1.ogg"
        },
        {
          "id": "gwv0m9",
          "type": "narration",
          "text": "You wipe the sleep from your eyes as you sit up in bed. At first, you're startled by the unfamiliar surroundings. Last night you were up late, and the lack of sleep has left you with a pounding headache."
        },
        {
          "id": "ypq71n",
          "type": "narration",
          "text": "You briefly consider spending a few more minutes in bed, when a voice calls out to you."
        },
        {
          "id": "snvmhg",
          "type": "narration",
          "text": "???\" \"You awake in there? Better get ready soon, it's already quarter to 7!"
        },
        {
          "id": "gwhyqs",
          "type": "narration",
          "text": "You quickly change into your regular clothes and open the door to your room. In the hall, the sounds and smells of sizzling bacon overwhelm your senses, and you head over to the kitchen."
        },
        {
          "id": "aiw5ys",
          "type": "bg",
          "bg": "bg kitchen"
        },
        {
          "id": "c0l0f2",
          "type": "image",
          "image": "hank friendly",
          "side": "center"
        },
        {
          "id": "s47z8o",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "There you are! I whipped us up some bacon and eggs. You know what they say, breakfast is the most important meal of the day!",
          "side": "center"
        },
        {
          "id": "e6t28x",
          "type": "narration",
          "text": "Hank hands you a plate as you take a seat next to him. In the center of the table sits a large serving tray, piled high with stacks of smoked bacon and eggs over easy. You take a modest amount for yourself, as Hank continues making conversation."
        },
        {
          "id": "4i8k6t",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "I tell you hwat, I haven't cooked this much in months! Usually it's just me and a bowl of canned soup. Now that I'm lookin' after a teenage boy, I'll have to keep the fridges stocked!",
          "side": "center"
        },
        {
          "id": "cbghjj",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "When I heard you were moving to Smalltown, Japan, I dang near spilled my beer. Of course I'd do anything for a son of Peggy's friend, but hwat a coincidence.",
          "side": "center"
        },
        {
          "id": "wxy0jg",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "I figured, coming out here for work, I wouldn't have any sort of company. Not that I mind! It'll be good having a buddy around, and we're only ten minutes away from your new school!",
          "side": "center"
        },
        {
          "id": "5wzbjf",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Speakin' of, I suspect the bus should be here any minute now. You'd better hurry on out, y'need to visit the counselor before class!",
          "side": "center"
        },
        {
          "id": "2is098",
          "type": "narration",
          "text": "You take one last heaping mouthful of eggs as you stand up from the table, and make your way outside to the bus stop."
        },
        {
          "id": "zfrhlq",
          "type": "jump",
          "scene_id": "fh2fl1",
          "transition": "none",
          "_targetLabel": "bus_stop"
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "fh2fl1",
      "label": "bus_stop",
      "bg": "bg house",
      "music": "happy.ogg",
      "events": [
        {
          "id": "p94jnb",
          "type": "bg",
          "bg": "bg house"
        },
        {
          "id": "uxkvxn",
          "type": "narration",
          "text": "The bus doesn't seem to be coming. You begin to wonder if Hank read the schedule wrong..."
        },
        {
          "id": "meimmn",
          "type": "music",
          "music": "happy.ogg"
        },
        {
          "id": "163qe1",
          "type": "narration",
          "text": "???\" \"ayy lol who the heck is this dude"
        },
        {
          "id": "h90pqt",
          "type": "narration",
          "text": "You hear a young girl talking behind you."
        },
        {
          "id": "nhjslp",
          "type": "image",
          "image": "takagi smug",
          "side": "center"
        },
        {
          "id": "22qdb5",
          "type": "narration",
          "text": "???\" \"lmao u new here bud? never seen anyone wearing denim suspenders in the summer b4"
        },
        {
          "id": "pc0xh3",
          "type": "narration",
          "text": "You introduce yourself, and explain that you're living with Hank for the rest of high school."
        },
        {
          "id": "84d007",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "cool, cool... you can call me takagi-san. dude we're like... neighbours 2 or something lol",
          "side": "center"
        },
        {
          "id": "3ng4lz",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "ayy new neighbour what's ur favorite color",
          "side": "center"
        },
        {
          "id": "dfd398",
          "type": "choice",
          "prompt": "",
          "opts": [
            {
              "id": "1rsnea",
              "text": "Crimson.",
              "scene": "xxezu4"
            },
            {
              "id": "gh1aad",
              "text": "Maroon.",
              "scene": "xxezu4"
            },
            {
              "id": "jyinb1",
              "text": "Ruby.",
              "scene": "xxezu4"
            },
            {
              "id": "cuhedo",
              "text": "Copper.",
              "scene": "xxezu4"
            },
            {
              "id": "kk7fxm",
              "text": "Red.",
              "scene": "xxezu4"
            }
          ]
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "xxezu4",
      "label": "bus_chat",
      "bg": null,
      "music": null,
      "events": [
        {
          "id": "jsqprs",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "rly? you seem more like a green kinda guy to me",
          "side": "center"
        },
        {
          "id": "ncpeo8",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "personally i'm a fan of clear. nothing out there quite like it tbh.",
          "side": "center"
        },
        {
          "id": "ntaauu",
          "type": "narration",
          "text": "In the distance, you see the city bus coming over the hill a few blocks away."
        },
        {
          "id": "wxh6fc",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "peacing out? ay no prob, i got class in a bit too. later bud",
          "side": "center"
        },
        {
          "id": "35g5ny",
          "type": "narration",
          "text": "You say your goodbyes to Takagi and board the city bus."
        },
        {
          "id": "qctye8",
          "type": "music",
          "music": ""
        },
        {
          "id": "9o09v8",
          "type": "jump",
          "scene_id": "gpmowk",
          "transition": "none",
          "_targetLabel": "school_start"
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "gpmowk",
      "label": "school_start",
      "bg": "bg office",
      "music": "spinball.ogg",
      "events": [
        {
          "id": "h9u9hs",
          "type": "bg",
          "bg": "bg school"
        },
        {
          "id": "bt50z5",
          "type": "narration",
          "text": "You arrive at the Smalltown Academy for Fragile Youth, your new high school. Remembering Hank's words, you quickly go inside and begin searching for the counselor's office."
        },
        {
          "id": "oekhp0",
          "type": "bg",
          "bg": "bg office"
        },
        {
          "id": "lybia8",
          "type": "image",
          "image": "krabs neutral",
          "side": "center"
        },
        {
          "id": "04wi4k",
          "type": "music",
          "music": "spinball.ogg"
        },
        {
          "id": "jou8p6",
          "type": "narration",
          "text": "???\" \"All the other shawties, they be callin' me wack, but I... something something... back..."
        },
        {
          "id": "iu5xoe",
          "type": "narration",
          "text": "He appears to be singing to himself..."
        },
        {
          "id": "fa2zln",
          "type": "narration",
          "text": "???\" \"Ack, boy, don't break me concentration!"
        },
        {
          "id": "kxzyu2",
          "type": "narration",
          "text": "You ask if you can speak to the school counselor."
        },
        {
          "id": "mahq4d",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "You're looking at him, lad! Eugene Krabs, world's greatest school counselor!",
          "side": "center"
        },
        {
          "id": "vsay3d",
          "type": "image",
          "image": "krabs greedy",
          "side": "center"
        },
        {
          "id": "414cnq",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "But I'm not long for this career, oh no. Once I get discovered, I'll be living the high life. Cars, chicks, and loads of money!",
          "side": "center"
        },
        {
          "id": "cx1kjp",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "You'll add me on Soundcloud, right boy? Just type Krabs Soundcloud into Bing, I'm the fifth or sixth result.",
          "side": "center"
        },
        {
          "id": "pgbana",
          "type": "choice",
          "prompt": "",
          "opts": [
            {
              "id": "upw80o",
              "text": "Sure, but I need to talk to you first.",
              "scene": "1s6wmn"
            },
            {
              "id": "w21dfv",
              "text": "Does Soundcloud still exist?",
              "scene": "mruxj2"
            }
          ]
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "mruxj2",
      "label": "krabs_bad",
      "bg": null,
      "music": null,
      "events": [
        {
          "id": "4u2kke",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Of course it does!",
          "side": "center"
        },
        {
          "id": "68tkzs",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Er, I think so. I haven't used it meself in a few months...",
          "side": "center"
        },
        {
          "id": "8ahedz",
          "type": "jump",
          "scene_id": "5t52ep",
          "transition": "dissolve",
          "_targetLabel": "krabs_chat"
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "1s6wmn",
      "label": "krabs_good",
      "bg": null,
      "music": null,
      "events": [
        {
          "id": "nknxbp",
          "type": "raw",
          "raw_code": "$ krabs_flag = True"
        },
        {
          "id": "mahvm6",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Of course, me boy! Anything for a fan!",
          "side": "center"
        },
        {
          "id": "oh06hy",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Oh, and make sure to upvote me on the Twitter. It helps with search engine alternization.",
          "side": "center"
        },
        {
          "id": "c2glep",
          "type": "jump",
          "scene_id": "5t52ep",
          "transition": "none",
          "_targetLabel": "krabs_chat"
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "5t52ep",
      "label": "krabs_chat",
      "bg": "bg class",
      "music": "ayaya.ogg",
      "events": [
        {
          "id": "ygo8ju",
          "type": "narration",
          "text": "You explain that you're a transfer student, and you don't know where your classes are."
        },
        {
          "id": "bh7nw6",
          "type": "bg",
          "bg": "cg krabs"
        },
        {
          "id": "2i5f3z",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Oh, a new student are ya? I'm sure it's so tough with your grade point averages and your mathematics.",
          "side": "center"
        },
        {
          "id": "rv53jg",
          "type": "bg",
          "bg": "cg alexa"
        },
        {
          "id": "6sawlv",
          "type": "music",
          "music": "despacito.ogg"
        },
        {
          "id": "gtnpw6",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Boo-hoo, let me play you Despacito on the world's smallest Alexa.",
          "side": "center"
        },
        {
          "id": "njcmpz",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "It really is the world's smallest Alexa. See?",
          "side": "center"
        },
        {
          "id": "c377nu",
          "type": "bg",
          "bg": "bg office"
        },
        {
          "id": "qdkkl4",
          "type": "image",
          "image": "krabs neutral",
          "side": "left"
        },
        {
          "id": "8wgprw",
          "type": "image",
          "image": "bloodstain neutral",
          "side": "right"
        },
        {
          "id": "plhvu4",
          "type": "narration",
          "text": "???\" \"Hey, Krabs-sensei. My locker isn't tall enough to fit a katana, so I was wondering if there were any teachers' lockers free."
        },
        {
          "id": "tv4at0",
          "type": "narration",
          "text": "???\" \"Are you listening to Despacito?"
        },
        {
          "id": "dxptmu",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Aye boy, the new kid was getting all worked up, so I played some soothing tunes for him. Would've played my own music, but I can't figure out how to get it into this thing.",
          "side": "center"
        },
        {
          "id": "lx4phe",
          "type": "music",
          "music": "forces.ogg"
        },
        {
          "id": "0wvqwi",
          "type": "narration",
          "text": "While Mr. Krabs fiddles with his Alexa, you introduce yourself to the student."
        },
        {
          "id": "b7jkwp",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "My name is Bloodstain McSwordman. You can say my name without an honorific. Please take care of me, Mario.",
          "side": "center"
        },
        {
          "id": "w8vhrf",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Good, good, everyone's making friends. Why don't you two run along, I have very important counselor duties to take care of.",
          "side": "center"
        },
        {
          "id": "5t0mtf",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Sure. My class was supposed to get a transfer student today, so I guess you're it. Our classroom is just down the hall.",
          "side": "center"
        },
        {
          "id": "za5vjw",
          "type": "bg",
          "bg": "bg class"
        },
        {
          "id": "8ntww9",
          "type": "narration",
          "text": "Bloodstain escorts you to your first class. The only seat left is directly under the air conditioner, and cold air blasts in your face for the rest of class."
        },
        {
          "id": "lz5zav",
          "type": "image",
          "image": "pjotr happy",
          "side": "center"
        },
        {
          "id": "xscjnw",
          "type": "music",
          "music": "ayaya.ogg"
        },
        {
          "id": "u4plz6",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "Hello class. Today we have new student to introduce. I am Peter Pjotr, teacher to you. Please make introduction.",
          "side": "center"
        },
        {
          "id": "n8g03x",
          "type": "narration",
          "text": "You stand and introduce yourself to the class."
        },
        {
          "id": "50k773",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "Very good introducing, Mario. You can find weapon at back of class. Please obtain gun for marksmanship practice.",
          "side": "center"
        },
        {
          "id": "fcmuta",
          "type": "raw",
          "raw_code": "hide pjotr",
          "_isSkipped": true
        },
        {
          "id": "yym4pm",
          "type": "image",
          "image": "bloodstain neutral",
          "side": "center"
        },
        {
          "id": "5hm7zb",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Since most of the students here have weak constitutions and frail bodies, we're given full military combat training for self-defence.",
          "side": "center"
        },
        {
          "id": "vdzopc",
          "type": "image",
          "image": "bloodstain katana",
          "side": "center"
        },
        {
          "id": "9szcee",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Of course, with my trusty Battleborn at my side, guns would only hold me back.",
          "side": "center"
        },
        {
          "id": "ia82yr",
          "type": "choice",
          "prompt": "",
          "opts": [
            {
              "id": "elr0vc",
              "text": "Cool samurai sword.",
              "scene": "5ahpcj"
            },
            {
              "id": "xo6dax",
              "text": "Why is it called Battleborn?",
              "scene": "5ahpcj"
            }
          ]
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "5ahpcj",
      "label": "bloodstain_talk",
      "bg": "bg house",
      "music": "recet1.ogg",
      "events": [
        {
          "id": "1at6ei",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "It's a family heirloom. My father gave it to me when I came of age. I should be honing my skills on the peaks of Fuji-san right now, but I'm stuck here.",
          "side": "center"
        },
        {
          "id": "lg409z",
          "type": "image",
          "image": "swimsuit saber",
          "side": "right"
        },
        {
          "id": "9mihji",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "See, I have a bit of a condition. If I don't pull a 5-star Servant every month, my heart will stop.",
          "side": "center"
        },
        {
          "id": "man623",
          "type": "image",
          "image": "bloodstain neutral",
          "side": "center"
        },
        {
          "id": "ui8smr",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Normally this would be no problem, as I've amassed quite the money hoard from my numerous successful contracts as a bounty hunter.",
          "side": "center"
        },
        {
          "id": "ligvbq",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "But I've run a bit low on funds recently, so I've been sent here to avoid over-exerting myself, in case my health detoriates further.",
          "side": "center"
        },
        {
          "id": "pgf7kj",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "It's been a few weeks already...",
          "side": "center"
        },
        {
          "id": "m4u1o8",
          "type": "narration",
          "text": "You place a friendly hand on Bloodstain's shoulder, and tell him that you can empathize with his condition."
        },
        {
          "id": "wmasif",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "You're allergic to pan-seared trout, eh? That's a rough one. The way I see it, we're in this together now.",
          "side": "center"
        },
        {
          "id": "9e04v2",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Now, if you'll excuse me, the new Rin dropped today, and I've been saving up.",
          "side": "center"
        },
        {
          "id": "j44o0o",
          "type": "raw",
          "raw_code": "hide bloodstain",
          "_isSkipped": true
        },
        {
          "id": "2gjcqb",
          "type": "raw",
          "raw_code": "hide swimsuit",
          "_isSkipped": true
        },
        {
          "id": "iooc13",
          "type": "image",
          "image": "pjotr happy",
          "side": "center"
        },
        {
          "id": "t8rgkp",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "Mario, it is your turn for the shooting of target. Please come to practice now.",
          "side": "center"
        },
        {
          "id": "i6wtym",
          "type": "narration",
          "text": "You continue with firearms training for the rest of the day."
        },
        {
          "id": "mp0gab",
          "type": "narration",
          "text": "Your proficiency leveled up!"
        },
        {
          "id": "6uc5ho",
          "type": "bg",
          "bg": "bg house"
        },
        {
          "id": "ed71zc",
          "type": "music",
          "music": "recet1.ogg"
        },
        {
          "id": "w50v9n",
          "type": "narration",
          "text": "After an uneventful bus ride, you return home."
        },
        {
          "id": "f1n9b7",
          "type": "narration",
          "text": "You try to open the front door, but it's locked, and Hank never gave you a key."
        },
        {
          "id": "lv9eas",
          "type": "choice",
          "prompt": "",
          "opts": [
            {
              "id": "mpuhye",
              "text": "Look for Hank behind the house.",
              "scene": "8z7fcm"
            },
            {
              "id": "k4qs2e",
              "text": "Look for Hank down the street.",
              "scene": "8z7fcm"
            }
          ]
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "8z7fcm",
      "label": "house_locked",
      "bg": null,
      "music": "happy.ogg",
      "events": [
        {
          "id": "5z9vdl",
          "type": "narration",
          "text": "You look for Hank, but he's nowhere in sight. Dejected, you take a seat at the bus stop and wait for him to get home."
        },
        {
          "id": "hb677t",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "lmao what the heck r u doin man. u just got here now ur already peacin out?",
          "side": "center"
        },
        {
          "id": "rc4y1w",
          "type": "image",
          "image": "takagi smug",
          "side": "center"
        },
        {
          "id": "24rpyk",
          "type": "music",
          "music": "happy.ogg"
        },
        {
          "id": "cqrflk",
          "type": "narration",
          "text": "You turn around, and see Takagi calling to you from her front door. When you make eye contact, she walks out to the bus stop next to you."
        },
        {
          "id": "j8d0i7",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "i was just catching the end of jeopardy and i saw u wandering the streets. did you lose ur house or something lol",
          "side": "center"
        },
        {
          "id": "8l92ty",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "seriously dude it's right behind us. i hear he's got like, a couch and some chairs. u don't need to sit on a bench",
          "side": "center"
        },
        {
          "id": "wvgqp1",
          "type": "narration",
          "text": "You explain that you're locked out."
        },
        {
          "id": "n4lnut",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "lmao for real? hold on man, he keeps a spare key in the mailbox",
          "side": "center"
        },
        {
          "id": "qntjsv",
          "type": "dialogue",
          "char_id": "vexi5q66",
          "pose": "neutral",
          "text": "pretty good hiding place tbh. no one ever gets mail anymore. really makes you think.",
          "side": "center"
        },
        {
          "id": "dxv7u7",
          "type": "narration",
          "text": "Takagi unlocks the front door, and heads straight inside. Confused, you follow her in."
        },
        {
          "id": "osm1l9",
          "type": "jump",
          "scene_id": "7le9vj",
          "transition": "none",
          "_targetLabel": "takagi_chat"
        }
      ],
      "ending_type": "true"
    },
    {
