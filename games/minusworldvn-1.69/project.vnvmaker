    {
      "id": "zz3igz",
      "label": "class_cancelled",
      "bg": null,
      "music": "spinball.ogg",
      "events": [
        {
          "id": "w4zoe4",
          "type": "image",
          "image": "bg school",
          "side": "center"
        },
        {
          "id": "albz25",
          "type": "wait",
          "dur": 2
        },
        {
          "id": "g64enu",
          "type": "image",
          "image": "bg class",
          "side": "center"
        },
        {
          "id": "iqbv7g",
          "type": "image",
          "image": "krabs neutral",
          "side": "center"
        },
        {
          "id": "igq1j9",
          "type": "music",
          "music": "spinball.ogg"
        },
        {
          "id": "rjysfq",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Hello, students and kids. I've been forced to make an announcement today.",
          "side": "center"
        },
        {
          "id": "0rh0pk",
          "type": "narration",
          "text": "Mr. Krabs is reading a crinkled piece of paper as he speaks to the class."
        },
        {
          "id": "kz9nrg",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Your teacher is busy being interviewed by the police today, so class is cancelled.",
          "side": "center"
        },
        {
          "id": "ecopx3",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Oh, I'm also supposed to tell you not to worry. And I shouldn't mention the police.",
          "side": "center"
        },
        {
          "id": "5x7e46",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Well, that's everything. Make sure to donate to my Patreon, once I figure out what Patreon is!",
          "side": "center"
        },
        {
          "id": "i4r97e",
          "type": "raw",
          "raw_code": "hide krabs",
          "_isSkipped": true
        },
        {
          "id": "mfmva9",
          "type": "image",
          "image": "bloodstain neutral",
          "side": "center"
        },
        {
          "id": "u29oag",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "This presents an excellent opportunity for us. Let us meet outside to discuss strategy, over lunch.",
          "side": "center"
        },
        {
          "id": "bptu2i",
          "type": "music",
          "music": ""
        },
        {
          "id": "a04sdx",
          "type": "jump",
          "scene_id": "bza41h",
          "transition": "none",
          "_targetLabel": "mike_chat"
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "bza41h",
      "label": "mike_chat",
      "bg": "bg school",
      "music": "shittygame.ogg",
      "events": [
        {
          "id": "k9vk6h",
          "type": "bg",
          "bg": "bg school"
        },
        {
          "id": "ij5erd",
          "type": "narration",
          "text": "You and Bloodstain go to the dirt path behind the school, and bring out your lunches."
        },
        {
          "id": "7jd4lq",
          "type": "image",
          "image": "bloodstain neutral",
          "side": "left"
        },
        {
          "id": "i0k7rx",
          "type": "image",
          "image": "masquerade mike",
          "side": "right"
        },
        {
          "id": "6ue5s3",
          "type": "music",
          "music": "shittygame.ogg"
        },
        {
          "id": "1xa9yc",
          "type": "dialogue",
          "char_id": "gc7wakzj",
          "pose": "neutral",
          "text": "Hey fucker, you're new around here, right? I'm Masquerade Mike, mind if I join you for lunch?",
          "side": "center"
        },
        {
          "id": "kzdznk",
          "type": "narration",
          "text": "You ask Bloodstain why he brought another friend."
        },
        {
          "id": "mqm1yr",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "He is not my friend.",
          "side": "center"
        },
        {
          "id": "xwslnc",
          "type": "dialogue",
          "char_id": "gc7wakzj",
          "pose": "neutral",
          "text": "Alright guys what're we talking about? Just some regular kid stuff eh haha! So, new kid, what're you eating today?",
          "side": "center"
        },
        {
          "id": "sycyjo",
          "type": "choice",
          "prompt": "",
          "opts": [
            {
              "id": "tijuy9",
              "text": "Spaghetti and meatballs.",
              "scene": "sfj0gc"
            },
            {
              "id": "sbpshs",
              "text": "A chili dog.",
              "scene": "sfj0gc"
            }
          ]
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "sfj0gc",
      "label": "mike_attack",
      "bg": "bg school",
      "music": "spyro.ogg",
      "events": [
        {
          "id": "yrsjlk",
          "type": "dialogue",
          "char_id": "gc7wakzj",
          "pose": "neutral",
          "text": "Whoa hey cool we should trade! I brought a sandwich here have a taste ffffffucker!",
          "side": "center"
        },
        {
          "id": "hcj82a",
          "type": "narration",
          "text": "Masquerade Mike shoves a sloppily put together sandwich in your mouth. Reflexively, you swallow a piece, choking a bit as you do."
        },
        {
          "id": "j1nqnf",
          "type": "narration",
          "text": "You taste rye bread, an excess of mayonnaise, pickles and some sort of fish."
        },
        {
          "id": "0lgird",
          "type": "narration",
          "text": "Fish?"
        },
        {
          "id": "6n1cnu",
          "type": "bg",
          "bg": "bg black"
        },
        {
          "id": "wv4byd",
          "type": "narration",
          "text": "Your vision fades to black."
        },
        {
          "id": "d4xirr",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Who are you?",
          "side": "center"
        },
        {
          "id": "s7z0xx",
          "type": "dialogue",
          "char_id": "gc7wakzj",
          "pose": "neutral",
          "text": "It doesn't matter who I am. What matters is my plan.",
          "side": "center"
        },
        {
          "id": "z619un",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Mario, are you alright? What the hell did you feed him?",
          "side": "center"
        },
        {
          "id": "p97jig",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Is this trout? He's allegic to pan-seared trout!",
          "side": "center"
        },
        {
          "id": "a5scsh",
          "type": "dialogue",
          "char_id": "gc7wakzj",
          "pose": "neutral",
          "text": "Yeah haha I know. I pan-fried it myself this morning!",
          "side": "center"
        },
        {
          "id": "c8oowt",
          "type": "narration",
          "text": "You feel your vision returning to normal."
        },
        {
          "id": "7psscj",
          "type": "dialogue",
          "char_id": "gc7wakzj",
          "pose": "neutral",
          "text": "Wait, fuck. Was it supposed to be pan-seared?",
          "side": "center"
        },
        {
          "id": "ws9ifl",
          "type": "bg",
          "bg": "bg school"
        },
        {
          "id": "i8inw3",
          "type": "image",
          "image": "bloodstain katana",
          "side": "left"
        },
        {
          "id": "3yis0v",
          "type": "image",
          "image": "masquerade mike",
          "side": "right"
        },
        {
          "id": "u176do",
          "type": "narration",
          "text": "As your vision returns to normal, you see Bloodstain pointing his katana at Masquerade Mike."
        },
        {
          "id": "ys79u0",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Was getting caught part of your plan?",
          "side": "center"
        },
        {
          "id": "3xcrfd",
          "type": "dialogue",
          "char_id": "gc7wakzj",
          "pose": "neutral",
          "text": "Of course.",
          "side": "center"
        },
        {
          "id": "iouizu",
          "type": "dialogue",
          "char_id": "gc7wakzj",
          "pose": "neutral",
          "text": "No one cared who I was until I put on the mask.",
          "side": "center"
        },
        {
          "id": "g7yfqu",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "If I take that off will you die?",
          "side": "center"
        },
        {
          "id": "4w8uhm",
          "type": "dialogue",
          "char_id": "gc7wakzj",
          "pose": "neutral",
          "text": "It would be extremely painful.",
          "side": "center"
        },
        {
          "id": "m3ieil",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "You're a big guy.",
          "side": "center"
        },
        {
          "id": "ffev2q",
          "type": "dialogue",
          "char_id": "gc7wakzj",
          "pose": "neutral",
          "text": "For you.",
          "side": "center"
        },
        {
          "id": "q895v3",
          "type": "music",
          "music": "forces.ogg"
        },
        {
          "id": "nw6osc",
          "type": "narration",
          "text": "You reach for Masquerade Mike's masquerade mask. It slips off easily."
        },
        {
          "id": "vgd3f5",
          "type": "image",
          "image": "masquerade heartless",
          "side": "right"
        },
        {
          "id": "qnwpti",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "What the hell?",
          "side": "center"
        },
        {
          "id": "687ckf",
          "type": "dialogue",
          "char_id": "drynjl7q",
          "pose": "neutral",
          "text": "That's right fuckers, it is I, Mike, Seeker of Darkness! MFGG hired me to kill you before you learned too much!",
          "side": "center"
        },
        {
          "id": "qzttte",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "You're with MFGG huh? Then you're going down. Time for my ultimate technique.",
          "side": "center"
        },
        {
          "id": "7ikagp",
          "type": "narration",
          "text": "Bloodstain places two fingers on his forehead and begins to concentrate intently. In an instant, he disappears from sight and reappears behind Mike."
        },
        {
          "id": "pzw2h6",
          "type": "image",
          "image": "bloodstain katana at right behind masquerade",
          "side": "center"
        },
        {
          "id": "5vu5ik",
          "type": "dialogue",
          "char_id": "drynjl7q",
          "pose": "neutral",
          "text": "Heh, you think a little trick like that's going to stop me? I'm immortal, you little shit!",
          "side": "center"
        },
        {
          "id": "hggiqv",
          "type": "dialogue",
          "char_id": "drynjl7q",
          "pose": "neutral",
          "text": "HYEEEUGH",
          "side": "center"
        },
        {
          "id": "0jehm6",
          "type": "narration",
          "text": "Mike collapses to the floor. His body is shredded in a dozen places, black ether seeping out in every direction."
        },
        {
          "id": "mis25p",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Nothing personal, kid.",
          "side": "center"
        },
        {
          "id": "bbo4gn",
          "type": "image",
          "image": "bloodstain neutral",
          "side": "left"
        },
        {
          "id": "jfedcz",
          "type": "narration",
          "text": "With a flourish, Bloodstain flicks his katana clean and sheathes it. He seems confident in his victory, but you wonder if the battle is truly over."
        },
        {
          "id": "esn0yn",
          "type": "raw",
          "raw_code": "hide masquerade heartless",
          "_isSkipped": true
        },
        {
          "id": "0cq4ua",
          "type": "narration",
          "text": "Mike's body melts into a dark puddle, and begins to bubble. You stand back, firearm at the ready, as it forms into a new shape."
        },
        {
          "id": "xg7x7k",
          "type": "image",
          "image": "void neutral",
          "side": "right"
        },
        {
          "id": "5psd1z",
          "type": "music",
          "music": "spyro.ogg"
        },
        {
          "id": "hojwe7",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "That was weird.",
          "side": "center"
        },
        {
          "id": "opn3cb",
          "type": "image",
          "image": "bloodstain katana",
          "side": "center"
        },
        {
          "id": "blwgvs",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Back for round 2, Mike-san?",
          "side": "center"
        },
        {
          "id": "4i59ie",
          "type": "raw",
          "raw_code": "hide bloodstain",
          "_isSkipped": true
        },
        {
          "id": "glfjwg",
          "type": "image",
          "image": "bloodstain katana",
          "side": "center"
        },
        {
          "id": "nikd7p",
          "type": "narration",
          "text": "Bloodstain moves in to attack the creature."
        },
        {
          "id": "3zx5jw",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "Whoa hey hey hey hold on! Mike is dead! I didn't even like that guy!",
          "side": "center"
        },
        {
          "id": "xst2je",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "S-Seriously, we're completely different people! He only listened to Slayer, I'm more into the Guess Who. I'm just part of the void that he was composed of!",
          "side": "center"
        },
        {
          "id": "3ui4p4",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Void-chan... Sou ka...",
          "side": "center"
        },
        {
          "id": "5io8gr",
          "type": "image",
          "image": "void confused",
          "side": "center"
        },
        {
          "id": "wvp2io",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "Hey, why don't you put those weapons away, fellas. I'm not going to attack you or anything! Look, I don't even have arms!",
          "side": "center"
        },
        {
          "id": "gigj3p",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Well Mario, it's your call. Can we trust Void-chan?",
          "side": "center"
        },
        {
          "id": "n1ua0q",
          "type": "choice",
          "prompt": "",
          "opts": [
            {
              "id": "8z0kej",
              "text": "We can trust her.",
              "scene": "8lh2e9"
            },
            {
              "id": "dmnrk3",
              "text": "She's too dangerous.",
              "scene": "0uhsc9"
            }
          ]
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "0uhsc9",
      "label": "void_bad",
      "bg": null,
      "music": null,
      "events": [
        {
          "id": "a1ey5s",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "I agree, Mario. There's no way we can let Void-chan go. Imagine the untold havoc she could cause.",
          "side": "center"
        },
        {
          "id": "02vdjo",
          "type": "image",
          "image": "void neutral",
          "side": "center"
        },
        {
          "id": "nngu0z",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "Well if that's how you feel, I'm getting out of here! I didn't want to hang out at a high school anyway, it all smells like teen spirit.",
          "side": "center"
        },
        {
          "id": "14lck6",
          "type": "narration",
          "text": "Void-chan runs off into the distance. Bloodstain attempts to give chase, but he's quickly reduced to panting on ground, his face bright red."
        },
        {
          "id": "rsqkou",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "I'm -huff- exhausted from the -huff- intense battle. We'll get her next time.",
          "side": "center"
        },
        {
          "id": "njx1ep",
          "type": "jump",
          "scene_id": "keqowc",
          "transition": "dissolve",
          "_targetLabel": "void_end"
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "8lh2e9",
      "label": "void_good",
      "bg": null,
      "music": null,
      "events": [
        {
          "id": "yndir0",
          "type": "raw",
          "raw_code": "$ void_flag = True"
        },
        {
          "id": "he87it",
          "type": "image",
          "image": "void happy",
          "side": "center"
        },
        {
          "id": "pp0oda",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "Thanks boys, you won't regret it! Well, it's about time for me to take off. I am nothing, but that doesn't mean I do nothing!",
          "side": "center"
        },
        {
          "id": "onnri2",
          "type": "raw",
          "raw_code": "hide void",
          "_isSkipped": true
        },
        {
          "id": "q3r1ib",
          "type": "jump",
          "scene_id": "keqowc",
          "transition": "none",
          "_targetLabel": "void_end"
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "keqowc",
      "label": "void_end",
      "bg": "bg wrestlers",
      "music": "wrestling.ogg",
      "events": [
        {
          "id": "akmknm",
          "type": "narration",
          "text": "You let Void-chan run off, and go back to eating lunch. While you eat, Bloodstain talks at length about how he plans to track down Moneybags."
        },
        {
          "id": "u3ojbi",
          "type": "narration",
          "text": "brrrring brrrrrrrrrrrrrring"
        },
        {
          "id": "1rj967",
          "type": "image",
          "image": "cellphone",
          "side": "left"
        },
        {
          "id": "vlv7bp",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "I've found the Megalomaniacs For the Greater Good. Meet me at the wrestling ring when you're ready.",
          "side": "center"
        },
        {
          "id": "749j9l",
          "type": "raw",
          "raw_code": "hide cellphone",
          "_isSkipped": true
        },
        {
          "id": "syia5r",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Mario, this is no time for personal phone calls. We'll never take down MFGG if you let your personal life distract you from the mission.",
          "side": "center"
        },
        {
          "id": "tr0wog",
          "type": "narration",
          "text": "You tell Bloodstain that Hank's found MFGG headquarters."
        },
        {
          "id": "zsg9ym",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "...I see. Well, time is of the essence. Shall we depart?",
          "side": "center"
        },
        {
          "id": "493c6n",
          "type": "narration",
          "text": "You and Bloodstain take the next bus into town."
        },
        {
          "id": "wbiyeg",
          "type": "bg",
          "bg": "bg wrestlers"
        },
        {
          "id": "6q5r87",
          "type": "music",
          "music": "wrestling.ogg"
        },
        {
          "id": "zjv9us",
          "type": "image",
          "image": "hank determined",
          "side": "left"
        },
        {
          "id": "7s3m5g",
          "type": "image",
          "image": "bloodstain katana",
          "side": "right"
        },
        {
          "id": "ojrd1u",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Good, you're here. The entrance is inside, but Barry Beefcake and friends kicked me out before I could break in.",
          "side": "center"
        },
        {
          "id": "d4sklg",
          "type": "narration",
          "text": "Wrestler\" \"Yeah, uh, we need to stop anyone who's, uh, snooping around. Boss's orders."
        },
        {
          "id": "iuhb2o",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Hank-dono, good to see you again. Shall we cut our way through?",
          "side": "center"
        },
        {
          "id": "ax0c1t",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Gosh son, no! They're just a group of fine, able-bodied men doing their job. We'll have to find another way in.",
          "side": "center"
        },
        {
          "id": "6sqqg7",
          "type": "image",
          "image": "bloodstain neutral",
          "side": "center"
        },
        {
          "id": "6x67nt",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Sou ka. I've been trained in movement through the shadows. Allow me to find us an infiltration route.",
          "side": "center"
        },
        {
          "id": "gupjq2",
          "type": "narration",
          "text": "Bloodstain wanders the area, looking for another entrance."
        },
        {
          "id": "r97rru",
          "type": "raw",
          "raw_code": "hide hank",
          "_isSkipped": true
        },
        {
          "id": "5b3tow",
          "type": "image",
          "image": "void neutral",
          "side": "left"
        },
        {
          "id": "omlb3g",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "Hey, it's you two!",
          "side": "center"
        },
        {
          "id": "hg0s6k",
          "type": "if",
          "condition": "void_flag",
          "scene_true": "e4uwmg",
          "scene_false": "gh7ny0"
        },
        {
          "id": "u4krcs",
          "type": "jump",
          "scene_id": "gh7ny0",
          "transition": "none",
          "_targetLabel": "wrestlers_lose"
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "gh7ny0",
      "label": "wrestlers_lose",
      "bg": null,
      "music": null,
      "events": [
        {
          "id": "om7cco",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "You tried to kill me earlier!",
          "side": "center"
        },
        {
          "id": "skpvo1",
          "type": "image",
          "image": "bloodstain katana",
          "side": "center"
        },
        {
          "id": "bhpk9x",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Indeed we did, and this is our chance to finish the job.",
          "side": "center"
        },
        {
          "id": "18nudw",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "No way, I'm not dealing with you jerks again! I'm a rising superstar in the professional wrestling scene!",
          "side": "center"
        },
        {
          "id": "wnzwya",
          "type": "narration",
          "text": "Wrestler\" \"Hey uh, Void-chan. Are these guys givin' you a hard time?"
        },
        {
          "id": "qcqdl3",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "Understatement of the year, Tommy! Porn 'stache and Neo over here are bad news! You should get the guys together and beat the hell out of them!",
          "side": "center"
        },
        {
          "id": "bapee7",
          "type": "image",
          "image": "bloodstain neutral",
          "side": "center"
        },
        {
          "id": "c63cf5",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "If it's a battle you want, so be it. My hand to hand technique rivals that of the greatest martial artists in history.",
          "side": "center"
        },
        {
          "id": "z480cw",
          "type": "image",
          "image": "bg black",
          "side": "center"
        },
        {
          "id": "0ahkni",
          "type": "raw",
          "raw_code": "hide void",
          "_isSkipped": true
        },
        {
          "id": "l4wrj2",
          "type": "raw",
          "raw_code": "hide bloodstain",
          "_isSkipped": true
        },
        {
          "id": "5tmsp0",
          "type": "narration",
          "text": "The never-ending horde of professional wrestlers overwhelm you and your group. Assaulted from all sides, you black out without even knowing what hit you. So ends your adventure."
        },
        {
          "id": "iko2ee",
          "type": "jump",
          "scene_id": null,
          "_isReturn": true
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "e4uwmg",
      "label": "wrestlers_bypass",
      "bg": null,
      "music": null,
      "events": [
        {
          "id": "vbyokt",
          "type": "image",
          "image": "void happy",
          "side": "center"
        },
        {
          "id": "6s8ua4",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "My dearest friends! How are you two doing? Still not interested in killing me, right?",
          "side": "center"
        },
        {
          "id": "mzwspt",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Hai, a cursory analysis of your frame and posture clearly identifies you as a non-threat.",
          "side": "center"
        },
        {
          "id": "39jjld",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "Sure, whatever you say! More to the point, what are you guys doing here? I figured tall, dark and not so handsome would be more into the anime, not pro wrestling.",
          "side": "center"
        },
        {
          "id": "p7g63c",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "In fact, we're attempting to gain access to this building to take down the Megalomaniacs For the Greater Good.",
          "side": "center"
        },
        {
          "id": "35002n",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "Well I have no idea what the heck that means, but I can get you in if you want. I'm the new face of Smalltown Wrestling! These guys do pretty much anything I ask.",
          "side": "center"
        },
        {
          "id": "gmxt3h",
          "type": "image",
          "image": "void neutral",
          "side": "center"
        },
        {
          "id": "zkmvgr",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "Hey boys! I'm going to show my friends here around the building! They're big fans of mine!",
          "side": "center"
        },
        {
          "id": "wq2l53",
          "type": "narration",
          "text": "Wrestler\" \"But Mr. Moneybags said we need to, uh, kick everyone out of the wrestling ring. End quote."
        },
        {
          "id": "qpc0h1",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "It'll be fine! I'll be with them the whole time, and when we're done I'll kick them out myself!",
          "side": "center"
        },
        {
          "id": "a4o1k0",
          "type": "narration",
          "text": "Wrestler\" \"Well uh, I cannot argue with the logic of your statements. Go right ahead."
        },
        {
          "id": "ojl6js",
          "type": "image",
          "image": "void happy",
          "side": "center"
        },
        {
          "id": "do5pt4",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "See? I'm practically royalty in here.",
          "side": "center"
        },
        {
          "id": "nn43wk",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "While I would've preferred the stealthy approach, a diplomatic solution can sometimes have merit.",
          "side": "center"
        },
        {
          "id": "maupme",
          "type": "if",
          "condition": "krabs_flag",
          "scene_true": "h9tf73",
          "scene_false": "pjbr5m"
        },
        {
          "id": "kcwyut",
          "type": "jump",
          "scene_id": "h9tf73",
          "transition": "none",
          "_targetLabel": "entry_success"
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "h9tf73",
      "label": "entry_success",
      "bg": null,
      "music": null,
      "events": [
        {
          "id": "ujnest",
          "type": "image",
          "image": "pjotr happy at leftish",
          "side": "center"
        },
        {
          "id": "e2z08j",
          "type": "image",
          "image": "krabs neutral at rightish",
          "side": "center"
        },
        {
          "id": "mcoqck",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "Students, what surprise it is to see you here! I am just finishing police interview and see new student and leather boy in periphery vision.",
          "side": "center"
        },
        {
          "id": "idoffr",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Stopping at the wrestling ring, eh? I used to throw a mean right hook back in my day! King Crab, they called me!",
          "side": "center"
        },
        {
          "id": "015j22",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "As teacher, I must inquire what you are doing at wrestling ring in mid-afternoon, when there is no wrestling.",
          "side": "center"
        },
        {
          "id": "ncbrhw",
          "type": "image",
          "image": "hank friendly behind pjotr",
          "side": "center"
        },
        {
          "id": "yooton",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Nice to meet you, sir. I'm Hank, Mario's caretaker.",
          "side": "center"
        },
        {
          "id": "643phy",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "We're attempting to infiltrate this facility to stop Moneybags and destroy the forces of darkness.",
          "side": "center"
        },
        {
          "id": "csrzra",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "Hey!",
          "side": "center"
        },
        {
          "id": "hpv3qu",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Present company excluded.",
          "side": "center"
        },
        {
          "id": "4jxz93",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "Very well. For safety of students, crab counselor and myself will escort students to defeat army of darkness.",
          "side": "center"
        },
        {
          "id": "59150j",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Sure, I'll lead the troops! My schedule's free anyway, I was just going to finish the paperwork for some new student.",
          "side": "center"
        },
        {
          "id": "daab3u",
          "type": "narration",
          "text": "You, Void-chan, Bloodstain, Peter Pjotr, Mr. Krabs and Hank head into the event center. Inside, Hank leads you to the entrance he found earlier."
        },
        {
          "id": "bxri8u",
          "type": "jump",
          "scene_id": "xpt9qr",
          "transition": "dissolve",
          "_targetLabel": "cave_scene"
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "pjbr5m",
      "label": "entry_fail",
      "bg": "bg cave",
      "music": "etrian.ogg",
      "events": [
        {
          "id": "86tkgw",
          "type": "narration",
          "text": "The group of wrestlers move aside, and your group heads into the event center. Hank takes you to a hidden room deep underground."
        },
        {
          "id": "5kapv0",
          "type": "bg",
          "bg": "bg cave"
        },
        {
          "id": "gifa3s",
          "type": "image",
          "image": "hank determined",
          "side": "left"
        },
        {
          "id": "3nwx9i",
          "type": "image",
          "image": "bloodstain neutral",
          "side": "right"
        },
        {
          "id": "i8bf52",
          "type": "image",
          "image": "void neutral",
          "side": "center"
        },
        {
          "id": "b5r9a1",
          "type": "music",
          "music": "etrian.ogg"
        },
        {
          "id": "bsxlyf",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Well, this is it. Their headquarters must be past this cave.",
          "side": "center"
        },
        {
          "id": "iu1rcz",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "A troublesome obstacle. We have no way of knowing how deep the cave extends, or where we may surface once we enter. Void-chan, would you survey the area for us?",
          "side": "center"
        },
        {
          "id": "5q1oz9",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "Me? No way! I still need to breathe like the rest of you! And besides, I never took any swimming lessons. If you want to get through this, you'll need some kinda fish, or maybe a crustacean.",
          "side": "center"
        },
        {
          "id": "ubeldw",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "I understand. If there's no alternative, we'll have to swim through and trust our instincts.",
          "side": "center"
        },
        {
          "id": "1lw3p7",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "I don't like it, but I think the boy is right. We'll all go together, and if you find an air pocket, you'd best come get the rest of us right quick.",
          "side": "center"
        },
        {
          "id": "6arbgt",
          "type": "raw",
          "raw_code": "hide hank",
          "_isSkipped": true
        },
        {
          "id": "5ujszh",
          "type": "raw",
          "raw_code": "hide bloodstain",
          "_isSkipped": true
        },
        {
          "id": "5lduly",
          "type": "raw",
          "raw_code": "hide void",
          "_isSkipped": true
        },
        {
          "id": "si0ibh",
          "type": "narration",
          "text": "You, Hank and Bloodstain enter the cave, in defiance of the clearly labeled warning. To your dismay, the cave proves too deep and dark to be navigated by chance. Your adventure ends before you can return to the surface."
        },
        {
          "id": "dh7xtj",
          "type": "jump",
          "scene_id": null,
          "_isReturn": true
        }
      ],
      "ending_type": "bad"
    },
    {
      "id": "xpt9qr",
      "label": "cave_scene",
      "bg": "bg lab",
      "music": "etrian.ogg",
      "events": [
        {
          "id": "advzz8",
          "type": "bg",
          "bg": "bg cave"
        },
        {
          "id": "yagbd9",
          "type": "image",
          "image": "pjotr happy",
          "side": "center"
        },
        {
          "id": "4l2s7u",
          "type": "image",
          "image": "krabs neutral at leftish",
          "side": "center"
        },
        {
          "id": "a11vac",
          "type": "image",
          "image": "bloodstain katana at rightish",
          "side": "center"
        },
        {
          "id": "k2fn0b",
          "type": "image",
          "image": "hank friendly",
          "side": "left"
        },
        {
          "id": "0jpxnk",
          "type": "image",
          "image": "void neutral",
          "side": "right"
        },
        {
          "id": "9ut7h2",
          "type": "music",
          "music": "spinball.ogg"
        },
        {
          "id": "oiozvq",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "I reckon this is it. My keyblade detects a darn powerful darkness beyond this cave.",
          "side": "center"
        },
        {
          "id": "5iy926",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "Yep, I feel it too!",
          "side": "center"
        },
        {
          "id": "jfemxi",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Then what are ye waiting for? Let's head on in and give those sissies what for!",
          "side": "center"
        },
        {
          "id": "06yrg6",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "But how can I shoot darkness with automatic weapon when there is water in the way?",
          "side": "center"
        },
        {
          "id": "vndcrr",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "We'll need to send someone in to scout the subterranean pool. I'd do so myself, but my clan traditionally uses a specialized aquatic strike force for missions like this.",
          "side": "center"
        },
        {
          "id": "dkbz3y",
          "type": "raw",
          "raw_code": "hide krabs",
          "_isSkipped": true
        },
        {
          "id": "d0x7m6",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Well this is a right big problem. We'll need to pick the best man for the job. I can hold my breath for about a minute and a half, can anyone do better?",
          "side": "center"
        },
        {
          "id": "6xqngv",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "Nope! I have, uh, chronic asthma. And black lung. And a heart condition. Wouldn't last a minute.",
          "side": "center"
        },
        {
          "id": "gnukjj",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "I have not yet learned swimming. Perhaps I could walk along bottom of pool? I see it in movie once.",
          "side": "center"
        },
        {
          "id": "bs8pc7",
          "type": "narration",
          "text": "While the group discusses who should enter the pool, the water slowly drains."
        },
        {
          "id": "vtasip",
          "type": "image",
          "image": "krabs neutral",
          "side": "center"
        },
        {
          "id": "sm3ra3",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "That was a cinch! They had a big lever labelled Pull to Drain Water. Even painted it bright red! If it's always this simple, I should give up on counseling and start breaking into houses.",
          "side": "center"
        },
        {
          "id": "e733ys",
          "type": "narration",
          "text": "The rest of the group stops to analyze the situation."
        },
        {
          "id": "0mw2y1",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Ahem. Our route is secure. Let's make haste into their headquarters, before anyone sees us.",
          "side": "center"
        },
        {
          "id": "o7hg6n",
          "type": "narration",
          "text": "The group begins walking through the cave, determined to stop Moneybags as soon as possible. The path is long and deep. The trip feels eerie, as if you're descending into the depths of hell."
        },
        {
          "id": "l253do",
          "type": "bg",
          "bg": "bg lab"
        },
        {
          "id": "xtjtqd",
          "type": "music",
          "music": "etrian.ogg"
        },
        {
          "id": "2i719u",
          "type": "narration",
          "text": "Finally, you come through an ice beam door into a strange, high tech area. The whole complex is supended over a massive pit, too deep to even see the bottom."
        },
        {
          "id": "doy4b0",
          "type": "image",
          "image": "bloodstain katana",
          "side": "center"
        },
        {
          "id": "grvari",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "The security is top-notch. Whatever's in here, Moneybags spared no expense in hiding it.",
          "side": "center"
        },
        {
          "id": "rsvfh0",
          "type": "image",
          "image": "pjotr happy",
          "side": "left"
        },
        {
          "id": "dseitl",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "Door may have been impossible to pass, had Texan man not known ice based witchcraft.",
          "side": "center"
        },
        {
          "id": "czpaax",
          "type": "image",
          "image": "hank friendly at leftish",
          "side": "center"
        },
        {
          "id": "omn1kg",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "That was just a Blizzaga spell, nothin' to holler about.",
          "side": "center"
        },
        {
          "id": "za67nz",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "Intruders, identify yourself.",
          "side": "center"
        },
        {
          "id": "srxwyu",
          "type": "narration",
          "text": "You scan the room, looking for the source of the voice. In a protected room several stories up, you see Moneybags speaking into a microphone."
        },
        {
          "id": "v5ft8z",
          "type": "image",
          "image": "moneybags neutral",
          "side": "right"
        },
        {
          "id": "0wa16q",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "It is I, Bloodstain McSwordman, son of Randy Pitchford and heir to the Pitchford clan. Surrender at once and I shall show you mercy.",
          "side": "center"
        },
        {
          "id": "sk4hbd",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "You're alive? I sent Masquerade Mike to assassinate you hours ago!",
          "side": "center"
        },
        {
          "id": "02bsus",
          "type": "image",
          "image": "void happy at rightish",
          "side": "center"
        },
        {
          "id": "hinsee",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "Yeah that didn't work out so well! He was kind of a moron, all things considered.",
          "side": "center"
        },
        {
          "id": "ewf4py",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "You've brought a creature of darkness with you? Is there anyone else in my inner sanctum I should know about?",
          "side": "center"
        },
        {
          "id": "s7kode",
          "type": "image",
          "image": "krabs neutral",
          "side": "center"
        },
        {
          "id": "olepnx",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "I came along too! Er, I mean, I'm the leader of this unit, Captain Eugene Krabs! Get down here and I'll show you a taste of me meaty claws!",
          "side": "center"
        },
        {
          "id": "8mk3en",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "Absolutely not! My plan is already in its final stages. I have no need to waste time on lower class consumers like you!",
          "side": "center"
        },
        {
          "id": "h0ra76",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "Soon, I will summon the most powerful Heartless in the universe. With it at my side, I'll be free to take control of every world government. No army on Earth can stop me!",
          "side": "center"
        },
        {
          "id": "qkzhr4",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "Then, once I've deregulated all industries, I'll be free to make as much money as I want! Brilliant, isn't it?",
          "side": "center"
        },
        {
          "id": "9wu5le",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "We will stop evil plan, dog in suit! There is no ethical consumption under capitalism!",
          "side": "center"
        },
        {
          "id": "ryth56",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "It's already too late! While you're stuck down here, I'll be out there, taking over the world!",
          "side": "center"
        },
        {
          "id": "4eyyqw",
          "type": "narration",
          "text": "Voice\" \"Escape sequence activated."
        },
        {
          "id": "31x0md",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "Shimatta! He has an escape pod!",
          "side": "center"
        },
        {
          "id": "l8tl33",
          "type": "dialogue",
          "char_id": "ij4bvggx",
          "pose": "neutral",
          "text": "So long, 99 percenters!",
          "side": "center"
        },
        {
          "id": "cxlqk2",
          "type": "raw",
          "raw_code": "hide moneybags",
          "_isSkipped": true
        },
        {
          "id": "y0hhf9",
          "type": "dialogue",
          "char_id": "ws42qjvq",
          "pose": "neutral",
          "text": "Dangit! If he summons that Heartless, the world'll go to hell in a handbasket!",
          "side": "center"
        },
        {
          "id": "gff9q2",
          "type": "dialogue",
          "char_id": "iawlw7rq",
          "pose": "neutral",
          "text": "Man with very large key is right. We must go to business dog at once.",
          "side": "center"
        },
        {
          "id": "bks3ms",
          "type": "dialogue",
          "char_id": "88vorrtj",
          "pose": "neutral",
          "text": "Alright, crew! Let's go... wherever he is!",
          "side": "center"
        },
        {
          "id": "vezpux",
          "type": "dialogue",
          "char_id": "uah68u25",
          "pose": "neutral",
          "text": "Do any of you genuises know where he went?",
          "side": "center"
        },
        {
          "id": "7krstd",
          "type": "dialogue",
          "char_id": "d7paq9vm",
          "pose": "neutral",
          "text": "I was not given sufficient information to predict his next move.",
          "side": "center"
        },
        {
          "id": "hdn057",
          "type": "raw",
          "raw_code": "hide bloodstain",
          "_isSkipped": true
        },
        {
          "id": "e5ukfp",
          "type": "raw",
          "raw_code": "hide hank",
          "_isSkipped": true
        },
        {
          "id": "72et1c",
          "type": "raw",
          "raw_code": "hide pjotr",
          "_isSkipped": true
        },
        {
          "id": "5y69ae",
          "type": "raw",
          "raw_code": "hide void",
          "_isSkipped": true
        },
        {
          "id": "w65cb6",
          "type": "raw",
          "raw_code": "hide krabs",
          "_isSkipped": true
        },
        {
          "id": "8oy452",
          "type": "jump",
          "scene_id": "mwaw58",
          "transition": "none",
          "_targetLabel": "call_choice"
        }
      ],
      "ending_type": "bad"
